---
/**
 * Dark closing invitation used at the end of each page. Routes visitors to
 * WhatsApp when a number is configured, otherwise to the contact page.
 */
import Button from '@/components/ui/Button.astro';
import Terrain from '@/components/visuals/Terrain.astro';
import { whatsappUrl } from '@/data/site';
import { routes, useI18n } from '@/i18n';

interface Props {
  title?: string;
  text?: string;
}

const { t, path } = useI18n(Astro);
const { title = t.cta.title, text = t.cta.text } = Astro.props;
const whatsapp = whatsappUrl(t.meta.whatsappMessage);
const splitAt = text.indexOf('. ');
const mobileLine = splitAt === -1 ? text : text.slice(0, splitAt + 1);
const mobileRest = splitAt === -1 ? '' : text.slice(splitAt + 2);
---

<section class="cta-band" aria-labelledby="cta-band-title">
  <Terrain preset="band" class="cta-band__terrain" />

  <div class="container cta-band__grid">
    <p class="eyebrow eyebrow--on-dark cta-band__eyebrow">{t.cta.eyebrow}</p>
    <h2 class="cta-band__title" id="cta-band-title">{title}</h2>
    <div class="cta-band__aside">
      <p class="cta-band__text">
        {mobileLine}
        {mobileRest && <span class="cta-band__text-more"> {mobileRest}</span>}
      </p>
      <div class="cta-band__actions">
        {whatsapp !== null ? (
          <Button href={whatsapp} external onDark>{t.cta.writeWhatsApp}</Button>
        ) : (
          <Button href={path(routes.contacto)} onDark>{t.cta.goContact}</Button>
        )}
        {whatsapp !== null && (
          <Button href={path(routes.contacto)} variant="text" onDark>{t.cta.otherContact}</Button>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-moss-800);
    color: var(--color-dark-text);
    padding-block: var(--space-section);
  }

  .cta-band :global(.cta-band__terrain) {
    opacity: 0.22;
  }

  .cta-band__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: var(--space-5);
  }

  .cta-band__eyebrow {
    grid-column: 1 / -1;
  }

  .cta-band__title {
    grid-column: 1 / 8;
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    font-weight: var(--weight-display);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .cta-band__aside {
    grid-column: 8 / 13;
    align-self: end;
  }

  .cta-band__text {
    color: var(--color-dark-text-muted);
    font-size: var(--text-md);
    max-width: 38ch;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5) var(--space-6);
    margin-top: var(--space-6);
  }

  @media (max-width: 900px) {
    .cta-band {
      padding-block: var(--space-7);
    }

    .cta-band__title,
    .cta-band__aside {
      grid-column: 1 / -1;
    }

    .cta-band__title {
      font-size: var(--text-2xl);
    }

    .cta-band__text-more {
      display: none;
    }

    .cta-band__actions {
      margin-top: var(--space-5);
    }
  }
</style>
