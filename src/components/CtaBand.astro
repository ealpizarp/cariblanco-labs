---
/**
 * Dark closing invitation used at the end of each page. Routes visitors to
 * WhatsApp when a number is configured, otherwise to the contact page.
 * Along its foot runs a liana with a troop of cariblancos sitting on it
 * (two adults and a young one; they live in troops, and we work as one),
 * looking out at the reader.
 */
import Button from '@/components/ui/Button.astro';
import Cariblanco from '@/components/visuals/Cariblanco.astro';
import Terrain from '@/components/visuals/Terrain.astro';
import Vine from '@/components/visuals/Vine.astro';
import { whatsappUrl } from '@/data/site';
import { routes, useI18n } from '@/i18n';

interface Props {
  title?: string;
  text?: string;
}

const { t, path } = useI18n(Astro);
const { title = t.cta.title, text = t.cta.text } = Astro.props;
const whatsapp = whatsappUrl(t.meta.whatsappMessage);
const splitAt = text.indexOf('. ');
const mobileLine = splitAt === -1 ? text : text.slice(0, splitAt + 1);
const mobileRest = splitAt === -1 ? '' : text.slice(splitAt + 2);
---

<section class="cta-band" aria-labelledby="cta-band-title">
  <Terrain preset="band" class="cta-band__terrain" />

  <div class="container cta-band__grid">
    <p class="eyebrow eyebrow--on-dark cta-band__eyebrow">{t.cta.eyebrow}</p>
    <h2 class="cta-band__title" id="cta-band-title">{title}</h2>
    <div class="cta-band__aside">
      <p class="cta-band__text">
        {mobileLine}
        {mobileRest && <span class="cta-band__text-more"> {mobileRest}</span>}
      </p>
      <div class="cta-band__actions">
        {whatsapp !== null ? (
          <Button href={whatsapp} external onDark>{t.cta.writeWhatsApp}</Button>
        ) : (
          <Button href={path(routes.contacto)} onDark>{t.cta.goContact}</Button>
        )}
        {whatsapp !== null && (
          <Button href={path(routes.contacto)} variant="text" onDark>{t.cta.otherContact}</Button>
        )}
      </div>
    </div>
  </div>

  <div class="cta-band__branch" aria-hidden="true">
    <Vine sag={8} leaves={12} class="cta-band__vine" />
    <Cariblanco pose="sit" onDark curious class="cta-band__monkey cta-band__monkey--a" />
    <Cariblanco pose="sit" onDark hold="leaf" class="cta-band__monkey cta-band__monkey--b" />
    <Cariblanco pose="sit" onDark curious class="cta-band__monkey cta-band__monkey--c" />
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-moss-800);
    color: var(--color-dark-text);
    /* Extra room at the foot for the troop on its liana. */
    padding-block: var(--space-section) calc(var(--space-section) + 6.5rem);
  }

  .cta-band :global(.cta-band__terrain) {
    opacity: 0.22;
  }

  /* A liana along the foot, with the troop seated on it, left of centre
     (the footer's own cariblanco peeks up on the right). With sag 8 the
     rope is about 13.5, 14.7 and 15.9 units down at 12%, 18% and 24.5% (a
     unit is 0.1cqw). A sitting monkey's seat is 1.45 widths down its box;
     its tail hangs a further 0.42 widths. */
  .cta-band__branch {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(1.5rem, 2.6vw, 2.4rem);
    z-index: 0;
    container-type: inline-size;
    pointer-events: none;
  }

  .cta-band__branch :global(.cta-band__vine) {
    color: var(--color-fern-400);
    --vine-leaf: rgb(197 208 99 / 0.2);
  }

  .cta-band__branch :global(.cta-band__monkey) {
    --sit-w: clamp(3.2rem, 5vw, 4.6rem);
    --at: 12%;
    --rope: 1.35cqw;
    position: absolute;
    top: calc(var(--rope) - var(--sit-w) * 1.45);
    left: calc(var(--at) - var(--sit-w) / 2);
    width: var(--sit-w);
  }

  /* The young one, between the two adults. */
  .cta-band__branch :global(.cta-band__monkey--b) {
    --sit-w: clamp(2.2rem, 3.4vw, 3.1rem);
    --at: 18%;
    --rope: 1.47cqw;
  }

  .cta-band__branch :global(.cta-band__monkey--c) {
    --sit-w: clamp(3rem, 4.6vw, 4.2rem);
    --at: 24.5%;
    --rope: 1.59cqw;
  }

  /* Out of step: each looks up at a different moment. */
  .cta-band__branch :global(.cta-band__monkey--c .cb__head) {
    animation-delay: 5.5s;
  }

  .cta-band__branch :global(.cta-band__monkey--b .cb__tail) {
    animation-delay: -1.5s;
  }

  @media (max-width: 600px) {
    .cta-band__branch :global(.cta-band__monkey) {
      --at: 16%;
    }

    .cta-band__branch :global(.cta-band__monkey--b) {
      --at: 33%;
      --rope: 1.7cqw;
    }

    .cta-band__branch :global(.cta-band__monkey--c) {
      --at: 49%;
      --rope: 1.9cqw;
    }
  }

  .cta-band__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: var(--space-5);
  }

  .cta-band__eyebrow {
    grid-column: 1 / -1;
  }

  .cta-band__title {
    grid-column: 1 / 8;
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    font-weight: var(--weight-display);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .cta-band__aside {
    grid-column: 8 / 13;
    align-self: end;
  }

  .cta-band__text {
    color: var(--color-dark-text-muted);
    font-size: var(--text-md);
    max-width: 38ch;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5) var(--space-6);
    margin-top: var(--space-6);
  }

  @media (max-width: 900px) {
    .cta-band {
      padding-block: var(--space-7) calc(var(--space-7) + 6rem);
    }

    .cta-band__title,
    .cta-band__aside {
      grid-column: 1 / -1;
    }

    .cta-band__title {
      font-size: var(--text-2xl);
    }

    .cta-band__text-more {
      display: none;
    }

    .cta-band__actions {
      margin-top: var(--space-5);
    }
  }
</style>
