---
/**
 * Dark closing invitation used at the end of each page. Routes visitors to
 * WhatsApp when a number is configured, otherwise to the contact page.
 * A vine drapes across its top, and a troop of cariblancos (mother and
 * young; they live in troops, and we work as one) swings from it.
 */
import Button from '@/components/ui/Button.astro';
import Cariblanco from '@/components/visuals/Cariblanco.astro';
import Terrain from '@/components/visuals/Terrain.astro';
import Vine from '@/components/visuals/Vine.astro';
import { whatsappUrl } from '@/data/site';
import { routes, useI18n } from '@/i18n';

interface Props {
  title?: string;
  text?: string;
}

const { t, path } = useI18n(Astro);
const { title = t.cta.title, text = t.cta.text } = Astro.props;
const whatsapp = whatsappUrl(t.meta.whatsappMessage);
const splitAt = text.indexOf('. ');
const mobileLine = splitAt === -1 ? text : text.slice(0, splitAt + 1);
const mobileRest = splitAt === -1 ? '' : text.slice(splitAt + 2);
---

<section class="cta-band" aria-labelledby="cta-band-title">
  <Terrain preset="band" class="cta-band__terrain" />

  <div class="container cta-band__grid">
    <p class="eyebrow eyebrow--on-dark cta-band__eyebrow">{t.cta.eyebrow}</p>
    <h2 class="cta-band__title" id="cta-band-title">{title}</h2>
    <div class="cta-band__aside">
      <p class="cta-band__text">
        {mobileLine}
        {mobileRest && <span class="cta-band__text-more"> {mobileRest}</span>}
      </p>
      <div class="cta-band__actions">
        {whatsapp !== null ? (
          <Button href={whatsapp} external onDark>{t.cta.writeWhatsApp}</Button>
        ) : (
          <Button href={path(routes.contacto)} onDark>{t.cta.goContact}</Button>
        )}
        {whatsapp !== null && (
          <Button href={path(routes.contacto)} variant="text" onDark>{t.cta.otherContact}</Button>
        )}
      </div>
    </div>
  </div>

  <div class="cta-band__canopy" aria-hidden="true">
    <Vine sag={30} leaves={12} class="cta-band__vine" />
    <Cariblanco pose="hang" vine={false} swing class="cta-band__monkey cta-band__monkey--a" />
    <Cariblanco pose="hang" vine={false} swing class="cta-band__monkey cta-band__monkey--b" />
    <Cariblanco pose="hang" vine={false} swing class="cta-band__monkey cta-band__monkey--c" />
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-moss-800);
    color: var(--color-dark-text);
    /* Extra room at the top for the troop hanging from the vine. */
    padding-block: calc(var(--space-section) + 4rem) var(--space-section);
  }

  .cta-band :global(.cta-band__terrain) {
    opacity: 0.22;
  }

  /* A vine across the top edge with a troop hanging from it. Rope height
     at x (of 1000): 10 + 39 * 3t(1 - t); at 66%, 78%, 90% that is about
     35, 30 and 21 units (cqw / 10). Grip is at (52, 10) of 100 × 150. */
  .cta-band__canopy {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 0;
    container-type: inline-size;
    pointer-events: none;
  }

  .cta-band__canopy :global(.cta-band__vine) {
    color: var(--color-fern-400);
    --vine-leaf: rgb(197 208 99 / 0.2);
  }

  .cta-band__canopy :global(.cta-band__monkey) {
    --hang-w: clamp(3rem, 5vw, 4.8rem);
    position: absolute;
    width: var(--hang-w);
    color: var(--color-dark-accent);
    --cb-hood: var(--color-mist-50);
    --cb-ring: var(--color-moss-800);
  }

  .cta-band__canopy :global(.cta-band__monkey--a) {
    top: calc(3.5cqw - var(--hang-w) * 0.1);
    left: calc(66% - var(--hang-w) * 0.52);
  }

  /* The young: smaller, and out of step with the others. */
  .cta-band__canopy :global(.cta-band__monkey--b) {
    --hang-w: clamp(2rem, 3.2vw, 3.1rem);
    top: calc(3cqw - var(--hang-w) * 0.1);
    left: calc(78% - var(--hang-w) * 0.52);
  }

  .cta-band__canopy :global(.cta-band__monkey--c) {
    top: calc(2.1cqw - var(--hang-w) * 0.1);
    left: calc(90% - var(--hang-w) * 0.52);
  }

  .cta-band__canopy :global(.cta-band__monkey--b .cb__body) {
    animation-delay: -1.2s;
  }

  .cta-band__canopy :global(.cta-band__monkey--c .cb__body) {
    animation-delay: -2.3s;
  }

  .cta-band__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: var(--space-5);
  }

  .cta-band__eyebrow {
    grid-column: 1 / -1;
  }

  .cta-band__title {
    grid-column: 1 / 8;
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    font-weight: var(--weight-display);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .cta-band__aside {
    grid-column: 8 / 13;
    align-self: end;
  }

  .cta-band__text {
    color: var(--color-dark-text-muted);
    font-size: var(--text-md);
    max-width: 38ch;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5) var(--space-6);
    margin-top: var(--space-6);
  }

  @media (max-width: 900px) {
    .cta-band {
      padding-block: calc(var(--space-7) + 3.5rem) var(--space-7);
    }

    .cta-band__title,
    .cta-band__aside {
      grid-column: 1 / -1;
    }

    .cta-band__title {
      font-size: var(--text-2xl);
    }

    .cta-band__text-more {
      display: none;
    }

    .cta-band__actions {
      margin-top: var(--space-5);
    }
  }
</style>
