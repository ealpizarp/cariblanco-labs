---
/**
 * A quiet footer: the name, the pages, one way to reach us, and the year.
 * A cariblanco peeks over the bottom edge, next to its name.
 */
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import Wordmark from '@/components/Wordmark.astro';
import Cariblanco from '@/components/visuals/Cariblanco.astro';
import Terrain from '@/components/visuals/Terrain.astro';
import { primaryNav } from '@/data/navigation';
import { site, whatsappUrl } from '@/data/site';
import { routes, useI18n } from '@/i18n';

const { locale, t, path } = useI18n(Astro);
const year = new Date().getFullYear();
const whatsapp = whatsappUrl(t.meta.whatsappMessage);
const nav = primaryNav(locale);
---

<footer class="site-footer">
  <Terrain preset="footer" class="site-footer__terrain" />

  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <Wordmark onDark />
      <p class="site-footer__tag">{t.meta.siteShortDescription}</p>
    </div>

    {whatsapp !== null ? (
      <a class="site-footer__cta" href={whatsapp} target="_blank" rel="noopener noreferrer">
        {t.footer.write}<span aria-hidden="true"> →</span><span class="sr-only">{t.nav.newWindow}</span>
      </a>
    ) : (
      <a class="site-footer__cta" href={path(routes.contacto)}>
        {t.nav.letsTalk}<span aria-hidden="true"> →</span>
      </a>
    )}
  </div>

  <div class="container site-footer__bottom">
    <nav aria-label={t.nav.footerLabel}>
      <ul class="site-footer__nav">
        {nav.map((item) => (
          <li><a class="link-underline" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="site-footer__legal">
      <span>© {year} {site.name} · Costa Rica</span>
      <LanguageSwitcher />
    </div>
  </div>

  <p class="site-footer__giant" aria-hidden="true">Cariblanco</p>
  <Cariblanco pose="peek" onDark class="site-footer__cariblanco" />
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(var(--space-7), 4vw, var(--space-8));
    background: var(--color-dark-bg);
    color: var(--color-dark-text-muted);
    border-top: 1px solid var(--color-dark-rule);
    font-size: var(--text-sm);
  }

  .site-footer :global(.site-footer__terrain) {
    opacity: 0.11;
  }

  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
  }

  .site-footer__tag {
    margin-top: var(--space-3);
    max-width: 48ch;
    text-wrap: balance;
  }

  .site-footer__cta {
    font-weight: var(--weight-semibold);
    color: var(--color-dark-accent);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-dark-rule);
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  /* margin-left: auto keeps it on the right when the page links wrap it
     onto its own line (tablet). */
  .site-footer__legal {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--color-dark-text-faint);
  }

  .site-footer__legal :global(.lang-switch) {
    border-color: rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.04);
  }

  .site-footer__legal :global(.lang-switch__opt) {
    color: var(--color-dark-text-muted);
  }

  .site-footer__legal :global(.lang-switch__opt[aria-current='true']) {
    color: var(--color-dark-bg);
    background: var(--color-dark-accent);
  }

  /* The name, cut by the page edge like a map title. */
  .site-footer__giant {
    max-width: none;
    margin: var(--space-6) 0 -0.26em;
    font-family: var(--font-serif);
    font-size: clamp(4rem, 15vw, 13rem);
    font-style: italic;
    line-height: 0.8;
    letter-spacing: -0.045em;
    text-align: center;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgb(197 208 99 / 0.3);
    user-select: none;
  }

  .site-footer :global(.site-footer__cariblanco) {
    position: absolute;
    right: max(var(--gutter), calc(50% - 41rem));
    bottom: -1px;
    width: clamp(4.75rem, 12vw, 11rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-footer :global(.site-footer__cariblanco) {
      transform-origin: 50% 100%;
      animation: footer-peek 9s var(--ease-out) infinite;
    }
  }

  /* Up, a look around, and back down behind the edge. */
  @keyframes footer-peek {
    0%, 8% { translate: 0 100%; }
    18%, 30% { translate: 0 0; rotate: 0deg; }
    36%, 50% { translate: 0 0; rotate: -4deg; }
    58%, 66% { translate: 0 0; rotate: 2deg; }
    76%, 100% { translate: 0 100%; rotate: 0deg; }
  }

  .site-footer a {
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-footer a:hover,
  .site-footer a:focus-visible,
  .site-footer a:active {
    color: var(--color-dark-text);
  }

  @media (max-width: 700px) {
    .site-footer__nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
      gap: 0 var(--space-4);
    }

    .site-footer__nav a {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
    }

    .site-footer__legal {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
