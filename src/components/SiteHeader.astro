---
import Button from '@/components/ui/Button.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import Wordmark from '@/components/Wordmark.astro';
import Pizote from '@/components/visuals/Pizote.astro';
import Terrain from '@/components/visuals/Terrain.astro';
import { isCurrentPage, primaryNav } from '@/data/navigation';
import { routes, useI18n } from '@/i18n';

const { locale, t, path } = useI18n(Astro);
const currentPath = Astro.url.pathname;
const nav = primaryNav(locale);
const onContact = isCurrentPage(path(routes.contacto), currentPath);
---

<header class="site-header">
  <div class="site-header__inner">
    <Wordmark />

    <nav class="site-nav" aria-label={t.nav.primaryLabel}>
      <ul class="site-nav__list">
        {nav.map((item) => {
          const current = isCurrentPage(item.href, currentPath);
          return (
            <li>
              <a class="site-nav__link" href={item.href} aria-current={current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="site-header__actions">
      <LanguageSwitcher />

      {!onContact && <Button href={path(routes.contacto)} size="sm">{t.nav.contactCta}</Button>}

      {/*
        The mobile menu uses the HTML popover API: no JavaScript is needed to
        open, close (Escape / light dismiss) or manage focus.
      */}
      <button
        class="menu-toggle"
        type="button"
        popovertarget="site-menu"
        aria-controls="site-menu"
        aria-haspopup="dialog"
        aria-expanded="false"
      >
        <span class="menu-toggle__icon" aria-hidden="true">
          <span class="menu-toggle__bar"></span>
          <span class="menu-toggle__bar"></span>
          <span class="menu-toggle__bar"></span>
        </span>
        <span class="menu-toggle__labels sr-only">
          <span class="menu-toggle__open">{t.nav.menuOpen}</span>
          <span class="menu-toggle__close" aria-hidden="true">{t.nav.menuClose}</span>
        </span>
      </button>
    </div>
  </div>

  <div id="site-menu" class="site-menu" popover>
    <Terrain preset="footer" class="site-menu__terrain" />
    <nav aria-label={t.nav.menuLabel}>
      <ol class="site-menu__list">
        {nav.map((item, index) => {
          const current = isCurrentPage(item.href, currentPath);
          return (
            <li style={`--i:${index}`}>
              <a class="site-menu__link" href={item.href} aria-current={current ? 'page' : undefined}>
                <span class="site-menu__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="site-menu__text">
                  <span class="site-menu__label">{item.label}</span>
                  <span class="site-menu__summary">{item.summary}</span>
                </span>
                <span class="site-menu__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          );
        })}
      </ol>
    </nav>
    <div class="site-menu__foot" style={`--i:${nav.length}`}>
      {!onContact && (
        <div class="site-menu__talk">
          <Button href={path(routes.contacto)} onDark>{t.nav.contactCta}</Button>
        </div>
      )}
      <p>{t.meta.siteShortDescription}</p>
      <Pizote pose="peek" class="site-menu__pizote" />
    </div>
  </div>

  <script is:inline>
    (function () {
      var menu = document.getElementById('site-menu');
      var toggle = document.querySelector('.menu-toggle');
      if (!menu || !toggle || menu.dataset.fwMenuBound) return;
      menu.dataset.fwMenuBound = 'true';
      var openLabel = toggle.querySelector('.menu-toggle__open');
      var closeLabel = toggle.querySelector('.menu-toggle__close');
      function sync() {
        var open = menu.matches(':popover-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (openLabel) openLabel.setAttribute('aria-hidden', open ? 'true' : 'false');
        if (closeLabel) closeLabel.setAttribute('aria-hidden', open ? 'false' : 'true');
      }
      menu.addEventListener('toggle', sync);
      toggle.addEventListener('click', function () {
        requestAnimationFrame(sync);
      });
    })();
  </script>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--glass-header);
    -webkit-backdrop-filter: var(--glass-blur-strong);
    backdrop-filter: var(--glass-blur-strong);
    border-bottom: 1px solid var(--color-rule-strong);
    view-transition-name: site-header;
  }

  .site-header__inner {
    width: min(100% - (var(--gutter) * 2), var(--container-max));
    margin-inline: auto;
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .site-nav__list {
    display: flex;
    gap: 0.15rem;
  }

  .site-nav__link {
    position: relative;
    display: inline-block;
    padding: var(--space-chip);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.01em;
    color: var(--color-text-soft);
    border-radius: var(--radius-sm);
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0.55rem;
    right: 0.55rem;
    bottom: 0.2rem;
    height: 1px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    color: var(--color-text);
    background: rgb(23 27 18 / 0.06);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-nav__link:hover::after,
    .site-nav__link:focus-visible::after {
      transform: scaleX(1);
    }
  }

  /* The current page: a lichen tag, as on a specimen drawer. */
  .site-nav__link[aria-current='page'] {
    color: var(--color-moss-950);
    background: var(--color-lichen-300);
  }

  .site-nav__link[aria-current='page']::after {
    display: none;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* ---- Menu toggle: a hamburger that folds into a close mark ---- */
  .menu-toggle {
    display: none;
    padding: var(--space-chip);
    border-radius: var(--radius-sm);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .menu-toggle:hover,
  .menu-toggle:focus-visible {
    background: rgb(23 27 18 / 0.06);
  }

  .menu-toggle__icon {
    position: relative;
    display: block;
    width: 1.375rem;
    height: 1rem;
  }

  .menu-toggle__bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform-origin: center;
  }

  .menu-toggle__bar:nth-child(1) {
    top: 0;
  }

  .menu-toggle__bar:nth-child(2) {
    top: calc(50% - 1px);
  }

  .menu-toggle__bar:nth-child(3) {
    top: calc(100% - 2px);
  }

  /* Open: the outer bars meet in the middle and cross; the middle one goes. */
  .site-header:has(.site-menu:popover-open) .menu-toggle__bar:nth-child(1) {
    top: calc(50% - 1px);
    rotate: 45deg;
  }

  .site-header:has(.site-menu:popover-open) .menu-toggle__bar:nth-child(2) {
    opacity: 0;
    scale: 0.2 1;
  }

  .site-header:has(.site-menu:popover-open) .menu-toggle__bar:nth-child(3) {
    top: calc(50% - 1px);
    rotate: -45deg;
  }

  .menu-toggle__close {
    display: none;
  }

  .site-header:has(.site-menu:popover-open) .menu-toggle__open {
    display: none;
  }

  .site-header:has(.site-menu:popover-open) .menu-toggle__close {
    display: inline;
  }

  /* Slide together first, then turn; reversed on close. */
  @media (prefers-reduced-motion: no-preference) {
    .menu-toggle__bar {
      transition:
        top 0.2s var(--ease-out) 0.15s,
        rotate 0.2s var(--ease-out),
        opacity 0.15s linear 0.1s,
        scale 0.2s var(--ease-out) 0.05s;
    }

    .site-header:has(.site-menu:popover-open) .menu-toggle__bar {
      transition:
        top 0.2s var(--ease-out),
        rotate 0.25s var(--ease-out) 0.18s,
        opacity 0.15s linear,
        scale 0.2s var(--ease-out);
    }
  }

  /* The page behind does not scroll while the menu is open. */
  :global(html:has(.site-menu:popover-open)) {
    overflow: hidden;
  }

  /* ---- Menu panel: a moss sheet that opens out from the toggle ---- */
  .site-menu {
    --menu-origin: calc(100% - var(--gutter) - 1.5rem) 0;
    position: fixed;
    inset: var(--header-height) 0 0 0;
    isolation: isolate;
    width: 100%;
    height: auto;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    /* Frosted moss: the page stays faintly visible behind the menu. */
    background: var(--glass-deep);
    -webkit-backdrop-filter: var(--glass-blur-strong);
    backdrop-filter: var(--glass-blur-strong);
    color: var(--color-dark-text);
    display: none;
    flex-direction: column;
    justify-content: space-between;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .site-menu:popover-open {
    display: flex;
  }

  .site-menu :global(.site-menu__terrain) {
    inset: auto 0 0 0;
    height: 70%;
    opacity: 0.19;
  }

  .site-menu__list {
    padding: var(--space-6) var(--gutter) 0;
  }

  .site-menu__list li {
    border-top: 1px solid var(--color-dark-rule);
  }

  .site-menu__list li:last-child {
    border-bottom: 1px solid var(--color-dark-rule);
  }

  .site-menu__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.5rem;
    padding: var(--space-4) 0;
  }

  .site-menu__index {
    flex: none;
    align-self: flex-start;
    padding-top: 0.55rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    color: var(--color-dark-accent);
    font-variant-numeric: tabular-nums;
  }

  .site-menu__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .site-menu__label {
    font-family: var(--font-serif);
    font-weight: var(--weight-heading);
    font-size: clamp(1.75rem, 7vw, 2.4rem);
    line-height: 1.1;
  }

  .site-menu__summary {
    max-width: 34ch;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--color-dark-text-muted);
  }

  .site-menu__arrow {
    flex: none;
    color: var(--color-dark-accent);
    opacity: 0.5;
  }

  .site-menu__link:hover .site-menu__arrow,
  .site-menu__link:focus-visible .site-menu__arrow {
    opacity: 1;
  }

  /* The current page wears the lichen tag, as in the desktop nav. */
  .site-menu__link[aria-current='page'] .site-menu__label {
    color: var(--color-dark-accent);
  }

  .site-menu__link[aria-current='page'] .site-menu__arrow {
    visibility: hidden;
  }

  .site-menu__link[aria-current='page'] .site-menu__index::after {
    content: '';
    display: block;
    width: 0.4rem;
    height: 0.4rem;
    margin-top: 0.45rem;
    border-radius: 50%;
    background: var(--color-dark-accent);
  }

  .site-menu__foot {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6) var(--gutter) var(--space-7);
    font-size: var(--text-sm);
    color: var(--color-dark-text-muted);
  }

  .site-menu__foot p {
    max-width: 32ch;
    padding-right: 5.5rem;
  }

  /* Pops up from the bottom edge when the menu opens. */
  .site-menu__foot :global(.site-menu__pizote) {
    position: absolute;
    right: var(--gutter);
    bottom: 0;
    width: 5.5rem;
    color: var(--color-dark-accent);
    --pz-ring: var(--color-dark-bg);
  }

  .site-menu__talk :global(.btn) {
    width: 100%;
    justify-content: center;
    min-height: 3rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Opens as a circle from the toggle, closes back into it. */
    .site-menu {
      clip-path: circle(0% at var(--menu-origin));
      transition:
        clip-path 0.5s cubic-bezier(0.65, 0, 0.35, 1),
        overlay 0.5s allow-discrete,
        display 0.5s allow-discrete;
    }

    .site-menu:popover-open {
      clip-path: circle(150% at var(--menu-origin));
    }

    @starting-style {
      .site-menu:popover-open {
        clip-path: circle(0% at var(--menu-origin));
      }
    }

    /* Links rise in one after another, each under a rule that draws across. */
    .site-menu:popover-open .site-menu__list li,
    .site-menu:popover-open :global(.site-menu__pizote) {
      animation: menu-pizote 0.6s cubic-bezier(0.3, 1.4, 0.5, 1) 0.45s both;
    }

    .site-menu:popover-open .site-menu__foot {
      animation: menu-rise 0.5s var(--ease-out) both;
      animation-delay: calc(0.16s + var(--i, 0) * 0.055s);
    }

    .site-menu__list li {
      position: relative;
      border-top-color: transparent;
    }

    .site-menu__list li::before {
      content: '';
      position: absolute;
      inset: -1px 0 auto 0;
      height: 1px;
      background: var(--color-dark-rule);
      transform-origin: left center;
    }

    .site-menu:popover-open .site-menu__list li::before {
      animation: menu-rule 0.6s var(--ease-out) both;
      animation-delay: calc(0.12s + var(--i, 0) * 0.055s);
    }

    .site-menu__label,
    .site-menu__arrow {
      transition:
        translate 0.25s var(--ease-out),
        opacity 0.25s var(--ease-out);
    }

    .site-menu__link:hover .site-menu__label,
    .site-menu__link:focus-visible .site-menu__label {
      translate: 0.35rem 0;
    }

    .site-menu__link:hover .site-menu__arrow,
    .site-menu__link:focus-visible .site-menu__arrow {
      translate: 0.25rem 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-menu {
      opacity: 0;
      transition:
        opacity 0.15s linear,
        overlay 0.15s allow-discrete,
        display 0.15s allow-discrete;
    }

    .site-menu:popover-open {
      opacity: 1;
    }

    @starting-style {
      .site-menu:popover-open {
        opacity: 0;
      }
    }
  }

  @keyframes menu-rise {
    from {
      opacity: 0;
      translate: 0 0.9rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes menu-rule {
    from {
      scale: 0 1;
    }
    to {
      scale: 1 1;
    }
  }

  /* The full nav needs ~940px in Spanish beside the wordmark, language
     switch and Contacto button; below that, the menu button. */
  @media (max-width: 959px) {
    .site-nav {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
    }

    .site-header__actions {
      gap: var(--space-3);
    }
  }

  @media (max-width: 420px) {
    .site-header__actions {
      gap: var(--space-2);
    }
  }

  /* "Conversemos" does not fit beside the wordmark, language switch, and
     menu until about 540px. Below that, the same action is the first control
     in the menu. */
  @media (max-width: 540px) {
    .site-header__actions :global(.btn) {
      display: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--color-surface);
    }
  }

  /* Browsers without the popover API: hide the toggle and show the menu as a
     plain list under the header so navigation still works. */
  @supports not selector(:popover-open) {
    .menu-toggle {
      display: none;
    }

    @media (max-width: 900px) {
      .site-menu {
        position: static;
        display: block;
      }
    }
  }

  @keyframes menu-pizote {
    from { translate: 0 100%; }
    to { translate: 0 0; }
  }
</style>
