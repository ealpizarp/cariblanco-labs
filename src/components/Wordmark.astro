---
/**
 * The name with the pizote's head as its mark. Links home.
 */
import Pizote from '@/components/visuals/Pizote.astro';
import { site } from '@/data/site';
import { interpolate, routes, useI18n, type Locale } from '@/i18n';

interface Props {
  onDark?: boolean;
  locale?: Locale;
}

const { onDark = false, locale: localeProp } = Astro.props;
const { t, path } = useI18n(Astro, localeProp);
---

<a
  class:list={['wordmark', { 'wordmark--on-dark': onDark }]}
  href={path(routes.home)}
  aria-label={interpolate(t.meta.homeAria, { name: site.name })}
>
  <Pizote pose="head" class="wordmark__mark" />
  {site.name}
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: var(--weight-heading);
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--color-text);
    white-space: nowrap;
  }

  .wordmark :global(.wordmark__mark) {
    flex: none;
    width: 1.55em;
    height: auto;
    margin-top: -0.2em;
    color: var(--color-primary);
    --pz-ring: var(--color-bg);
    --pz-mark: var(--color-paper);
  }

  .wordmark--on-dark {
    color: var(--color-dark-text);
  }

  .wordmark--on-dark :global(.wordmark__mark) {
    color: var(--color-dark-accent);
    --pz-ring: var(--color-dark-bg);
  }

  @media (max-width: 420px) {
    .wordmark {
      font-size: 1.2rem;
    }
  }
</style>
