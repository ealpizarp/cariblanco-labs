---
/**
 * Process, stage 4. The launch checklist, ticked off, then live.
 * Decorative: the step text beside it carries the meaning. Animations run
 * once, when the stage is seen (see `.reveal` in scripts/motion.ts).
 */
import { useI18n } from '@/i18n';

const scenes = useI18n(Astro).t.process.scenes;
---

<ul class="scene scene--list">
  {scenes.launch.map((item, k) => (
    <li class="launch__item" style={`--k:${k}`}>
      <svg class="launch__check" viewBox="0 0 20 20" fill="none" focusable="false">
        <circle class="launch__ring" cx="10" cy="10" r="8.5" pathLength="100" />
        <path class="launch__tick" d="M6 10.4 L8.8 13.1 L14 7.6" pathLength="100" />
      </svg>
      <span>{item.label}</span>
      {item.optional && <em>{scenes.optional}</em>}
    </li>
  ))}
  <li class="launch__live" style={`--k:${scenes.launch.length}`}>
    <span class="launch__dot"></span>
    {scenes.live}
  </li>
</ul>

<style>
  /* IV. Launch */
  .scene--list {
    display: grid;
    gap: 0.55rem;
    padding: var(--space-4) var(--space-5);
  }

  .launch__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .launch__item em {
    margin-left: auto;
    font-size: var(--text-xs);
    font-style: normal;
    color: var(--color-text-muted);
  }

  .launch__check {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
  }

  .launch__ring {
    stroke: var(--color-moss-700);
    stroke-width: 1.2;
    fill: var(--color-lichen-100);
  }

  .launch__tick {
    stroke: var(--color-moss-800);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .launch__live {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule);
    font-weight: var(--weight-semibold);
    color: var(--color-moss-800);
  }

  .launch__dot {
    position: relative;
    width: 0.6rem;
    height: 0.6rem;
    margin-inline: 0.28rem;
    border-radius: 50%;
    background: var(--color-clay);
  }

  .launch__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--color-clay);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .launch__item {
      animation: grow-rise 0.35s var(--ease-out) both;
      animation-delay: calc(0.35s + var(--k, 0) * 0.22s);
    }

    .launch__tick {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: grow-draw 0.35s var(--ease-out) forwards;
      animation-delay: calc(0.55s + var(--k, 0) * 0.22s);
    }

    .launch__live {
      animation: grow-rise 0.4s var(--ease-out) both;
      animation-delay: calc(0.4s + var(--k, 0) * 0.22s);
    }

    .launch__dot::after {
      animation: grow-ping 2.4s var(--ease-out) 2s infinite;
    }

    :global(.reveal--wait:not(.is-in)) :is(.launch__item, .launch__tick, .launch__live) {
      animation-play-state: paused;
    }
  }
</style>
