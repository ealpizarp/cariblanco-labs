---
/**
 * Process page: what stays in the client's name, set as a signed deed.
 */
import LineGlyph from '@/components/visuals/LineGlyph.astro';
import { useI18n } from '@/i18n';

const { t } = useI18n(Astro);
const own = t.process.own;
---

<section class="own" aria-labelledby="own-title">
  <div class="container own__grid">
    <div class="own__copy">
      <LineGlyph name="key" class="glyph--draw own__glyph" />
      <p class="eyebrow">{own.label}</p>
      <h2 class="own__note" id="own-title">{t.process.note}</h2>
    </div>
    <div class="own__deed reveal">
      <ul class="own__items">
        {own.items.map((item, k) => (
          <li style={`--k:${k}`}>
            <span>{item}</span>
            <span class="own__leader" aria-hidden="true"></span>
            <svg class="own__tick" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path d="M5 10.5 L8.5 14 L15 6.5" pathLength="100" />
            </svg>
          </li>
        ))}
      </ul>
      <span class="own__stamp" aria-hidden="true">
        <span>{own.stamp}</span>
      </span>
    </div>
  </div>
</section>

<style>
  /* ---- In your name ---- */
  .own {
    padding-block: var(--space-section-gap);
    border-top: 1px solid var(--color-rule);
  }

  .own__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .own__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .own__copy :global(.own__glyph) {
    --glyph-size: 3.25rem;
  }

  .own__note {
    max-width: 28ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.2;
  }

  .own__deed {
    position: relative;
    width: min(100%, 26rem);
    padding: var(--space-6) var(--space-6) var(--space-7);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-md);
    /* A double rule, like a certificate's border. */
    box-shadow: 0 0 0 5px var(--color-bg), 0 0 0 6px var(--color-rule-strong);
  }

  .own__items {
    display: grid;
    gap: var(--space-4);
  }

  .own__items li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
  }

  .own__leader {
    flex: 1;
    border-bottom: 1px dotted var(--color-rule-strong);
    transform-origin: 0 50%;
  }

  .own__tick {
    flex: none;
    align-self: center;
    width: 1.2rem;
    height: 1.2rem;
  }

  .own__tick path {
    stroke: var(--color-clay);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .own__stamp {
    position: absolute;
    right: -1.25rem;
    bottom: -1.5rem;
    display: grid;
    place-items: center;
    width: 6.5rem;
    height: 6.5rem;
    padding: 0.6rem;
    border: 2px solid var(--color-clay);
    border-radius: 50%;
    background: var(--color-bg);
    box-shadow: inset 0 0 0 4px var(--color-bg), inset 0 0 0 5px var(--color-clay);
    color: var(--color-clay);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    line-height: 1.25;
    text-align: center;
    text-transform: uppercase;
    rotate: -12deg;
  }

  @media (min-width: 700px) {
    .own__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      column-gap: clamp(2rem, 6vw, 6rem);
    }

    .own__deed {
      justify-self: center;
    }
  }

  /* Below desktop the deed reaches the content edge, so the stamp tucks
     inside it instead of hanging past the gutter. */
  @media (max-width: 899px) {
    .own__deed {
      padding-bottom: var(--space-8);
    }

    .own__stamp {
      right: var(--space-4);
      bottom: -1.75rem;
      width: 5.5rem;
      height: 5.5rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .own__leader {
      animation: grow-ink 0.6s var(--ease-out) both;
      animation-delay: calc(0.3s + var(--k, 0) * 0.2s);
    }

    .own__tick path {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: grow-draw 0.35s var(--ease-out) forwards;
      animation-delay: calc(0.7s + var(--k, 0) * 0.2s);
    }

    .own__stamp {
      animation: grow-stamp 0.45s cubic-bezier(0.3, 1.4, 0.5, 1) 1.7s both;
    }

    :global(.reveal--wait:not(.is-in)) :is(.own__leader, .own__tick path, .own__stamp) {
      animation-play-state: paused;
    }
  }
</style>
