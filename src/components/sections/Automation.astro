---
/**
 * Automation page body, in the order a visitor asks:
 * how it comes together (four glyphs on one stem), when it works (a 24-hour
 * dial), what it does (each capability with a two-line exchange), what it
 * does not do, and where the plan lives. Each fact appears once.
 */
import Button from '@/components/ui/Button.astro';
import Plate from '@/components/ui/Plate.astro';
import Contours from '@/components/visuals/Contours.astro';
import HoursDial from '@/components/visuals/HoursDial.astro';
import LineGlyph, { type GlyphName } from '@/components/visuals/LineGlyph.astro';
import { routes, useI18n } from '@/i18n';

const { t, path } = useI18n(Astro);
const workGlyphs: GlyphName[] = ['listen', 'choose', 'connect', 'tune'];
const work = t.automation.work.map((step, index) => ({ ...step, glyph: workGlyphs[index] ?? 'listen' }));
const steps = t.automation.stepTitles.map((title, index) => {
  const text = t.automation.doesItems[index];
  if (text === undefined) throw new Error('automation step is missing its text.');
  return { title, text, example: t.automation.examples[index] ?? [] };
});
const hours = t.automation.hours;
---

<section class="section section--page auto-work" aria-labelledby="auto-work-title">
  <div class="container">
    <header class="auto-block__intro">
      <p class="eyebrow">{t.automation.workLabel}</p>
      <h2 class="auto-block__title" id="auto-work-title">{t.automation.workTitle}</h2>
    </header>

    <div class="auto-work__field reveal">
      <svg class="auto-work__vine" viewBox="0 0 1000 60" preserveAspectRatio="none" fill="none" aria-hidden="true">
        <path
          class="auto-work__vine-path"
          pathLength="100"
          d="M40 32 C 160 8 240 52 375 30 S 590 6 625 30 S 840 54 960 28"
        />
      </svg>
      <ol class="auto-work__steps">
        {work.map((step, index) => (
          <li class="auto-work__step" style={`--i:${index}`}>
            <span class="auto-work__bud">
              <LineGlyph name={step.glyph} class="glyph--draw" delay={0.35 + index * 0.28} />
            </span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<section class="section auto-hours" aria-labelledby="auto-hours-title">
  <div class="auto-hours__terrain" aria-hidden="true">
    <Contours preset="band" />
  </div>
  <div class="container auto-hours__grid">
    <div class="auto-hours__copy">
      <Plate numeral="24 h" label={hours.label} onDark />
      <h2 class="auto-hours__title" id="auto-hours-title">{hours.title}</h2>
      <p class="auto-hours__text">{hours.text}</p>
      <dl class="auto-hours__legend">
        <div>
          <dt><span class="auto-hours__key auto-hours__key--open" aria-hidden="true"></span>{hours.open}</dt>
          <dd>{hours.openValue}</dd>
        </div>
        <div>
          <dt><span class="auto-hours__key auto-hours__key--assistant" aria-hidden="true"></span>{hours.assistant}</dt>
          <dd>{hours.assistantValue}</dd>
        </div>
        <div>
          <dt><span class="auto-hours__key auto-hours__key--arrival" aria-hidden="true"></span>{hours.arrival}</dt>
          <dd>{hours.arrivalValue}</dd>
        </div>
      </dl>
    </div>
    <HoursDial />
  </div>
</section>

<section class="section section--page auto-flow" aria-labelledby="auto-flow-title">
  <div class="container auto-flow__grid">
    <header class="auto-block__intro auto-flow__intro">
      <p class="eyebrow">{t.automation.flowLabel}</p>
      <h2 class="auto-block__title" id="auto-flow-title">{t.automation.flowTitle}</h2>
    </header>

    <ol class="auto-flow__steps">
      {steps.map((step, index) => (
        <li class="auto-flow__step reveal">
          <span class="auto-flow__num" aria-hidden="true"></span>
          {index < steps.length - 1 && (
            <svg class="auto-flow__stem" viewBox="0 0 44 80" preserveAspectRatio="none" fill="none" aria-hidden="true">
              <path
                class="auto-flow__stem-path"
                pathLength="100"
                d={index % 2 === 0 ? 'M22 0 C 14 28 18 54 22 80' : 'M22 0 C 30 26 24 54 22 80'}
              />
              <path
                class="auto-flow__stem-path auto-flow__stem-path--sprig"
                pathLength="100"
                d={index % 2 === 0 ? 'M18 36 C 10 30 6 26 3 30' : 'M16 48 C 8 56 5 64 7 72'}
              />
            </svg>
          )}
          <div class="auto-flow__body">
            <h3 class="auto-flow__step-title">{step.title}</h3>
            <p>{step.text}</p>
            {step.example.length > 0 && (
              <div class="auto-flow__demo" aria-hidden="true">
                {step.example.map((line, at) => (
                  <span class:list={['auto-flow__bubble', `auto-flow__bubble--${line.from}`]} style={`--at:${at}`}>
                    {line.text}
                  </span>
                ))}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section section--page auto-scope" aria-labelledby="automation-scope-title">
  <div class="container auto-scope__grid">
    <header class="auto-block__intro">
      <h2 class="auto-block__title" id="automation-scope-title">{t.automation.doesNot}</h2>
    </header>

    <ul class="auto-scope__list reveal">
      {
        t.automation.doesNotItems.map((item, index) => (
          <li class="auto-scope__item" style={`--i:${index}`}>
            <svg class="auto-scope__node" viewBox="0 0 16 16" width="18" height="18" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="5.25" stroke="currentColor" stroke-width="1.25" />
              <circle class="auto-scope__seed" cx="8" cy="8" r="2.1" fill="var(--color-clay)" />
            </svg>
            {index < t.automation.doesNotItems.length - 1 && (
              <svg class="auto-scope__stem" viewBox="0 0 18 80" width="18" preserveAspectRatio="none" fill="none" aria-hidden="true">
                <path
                  d={index % 2 === 0 ? 'M9 0 C 5 26 12 54 9 80' : 'M9 0 C 13 26 6 54 9 80'}
                  stroke="currentColor"
                  stroke-width="1.25"
                  stroke-linecap="round"
                  vector-effect="non-scaling-stroke"
                />
              </svg>
            )}
            <p>{item}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section section--page auto-plan" aria-labelledby="auto-plan-title">
  <div class="container auto-plan__row">
    <h2 class="auto-plan__title" id="auto-plan-title">{t.automation.planTitle}</h2>
    <p>{t.automation.planText}</p>
    <Button href={`${path(routes.servicios)}#asistente`} variant="text">{t.automation.planLink}</Button>
  </div>
</section>

<style>
  .auto-block__intro {
    display: grid;
    gap: var(--space-4);
  }

  .auto-block__title {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: var(--weight-display);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-display);
    max-width: 18ch;
  }

  /* ---- How it comes together: four glyphs on one stem ---- */
  .auto-work__field {
    position: relative;
    margin-top: var(--space-7);
  }

  .auto-work__vine {
    display: none;
  }

  .auto-work__steps {
    display: grid;
    gap: var(--space-6);
  }

  .auto-work__step {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    column-gap: var(--space-4);
    align-items: start;
  }

  .auto-work__bud {
    grid-row: 1 / 4;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    --glyph-size: 2.4rem;
    transition:
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .auto-work__step:hover .auto-work__bud {
    transform: translateY(-3px) rotate(-4deg);
    border-color: var(--color-moss-700);
  }

  .auto-work__step h3 {
    margin: var(--space-2) 0;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .auto-work__step p {
    margin: 0;
    color: var(--color-text-soft);
  }

  /* ---- After hours: the dial on moss ---- */
  .auto-hours {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-section-gap);
    background: var(--color-dark-bg);
    color: var(--color-dark-text);
  }

  .auto-hours__terrain {
    position: absolute;
    inset: 0;
    z-index: -1;
    --contour-color: var(--color-lichen-300);
    --contour-opacity: 0.07;
  }

  .auto-hours__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    justify-items: start;
  }

  .auto-hours__copy {
    display: grid;
    gap: var(--space-4);
  }

  .auto-hours__title {
    max-width: 16ch;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
  }

  .auto-hours__text {
    max-width: 44ch;
    color: var(--color-dark-text-muted);
  }

  .auto-hours__legend {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-dark-rule);
  }

  .auto-hours__legend div {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .auto-hours__legend dt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--weight-semibold);
  }

  .auto-hours__legend dd {
    margin: 0;
    color: var(--color-dark-text-muted);
  }

  .auto-hours__key {
    flex: none;
    width: 1.5rem;
    height: 0.5rem;
    border-radius: var(--radius-pill);
  }

  .auto-hours__key--open {
    background: var(--color-dark-text);
  }

  .auto-hours__key--assistant {
    height: 0;
    border-top: 3px dotted var(--color-dark-accent);
    border-radius: 0;
  }

  .auto-hours__key--arrival {
    width: 0.6rem;
    height: 0.6rem;
    margin-inline: 0.45rem;
    background: var(--color-dark-emphasis);
  }

  /* ---- What it does: each capability with a short exchange ---- */
  section.auto-flow {
    padding-top: var(--space-section-gap);
  }

  .auto-flow__grid {
    display: grid;
    gap: var(--space-6);
  }

  .auto-flow__steps {
    --bud: 2.75rem;
    display: grid;
  }

  .auto-flow__step {
    position: relative;
    display: grid;
    grid-template-columns: var(--bud) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    padding-bottom: var(--space-6);
  }

  .auto-flow__step:last-child {
    padding-bottom: 0;
  }

  /* A stem through the buds. It leans, the way the other drawings do,
     and stops in the last bud. The type stays to the right of it. */
  .auto-flow__stem {
    position: absolute;
    z-index: 0;
    left: 0;
    top: calc(var(--bud) / 2);
    width: var(--bud);
    height: 100%;
    color: var(--color-moss-800);
    opacity: 0.55;
    pointer-events: none;
  }

  .auto-flow__stem-path {
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .auto-flow__stem-path--sprig {
    stroke-width: 1.05;
  }

  .auto-flow__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--bud);
    height: var(--bud);
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-style: italic;
  }

  /* A seed in each bud. */
  .auto-flow__num::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-lichen-300);
  }

  .auto-flow__step:nth-child(even) .auto-flow__num::after {
    background: var(--color-clay);
  }

  .auto-flow__step:nth-child(even) .auto-flow__num {
    background: var(--color-wash);
    color: var(--color-primary-strong);
    border: 1px solid var(--color-rule-strong);
  }

  .auto-flow__step-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .auto-flow__body > p {
    margin: 0;
    color: var(--color-text-soft);
    max-width: 52ch;
  }

  .auto-flow__demo {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 24rem;
    margin-top: var(--space-4);
    padding: var(--space-3);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-wash);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .auto-flow__bubble {
    max-width: 88%;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    background: var(--color-paper);
    box-shadow: 0 1px 0 rgb(16 24 22 / 0.08);
  }

  .auto-flow__bubble--client {
    align-self: flex-start;
    border-top-left-radius: 0;
  }

  .auto-flow__bubble--assistant {
    align-self: flex-end;
    border-top-right-radius: 0;
    background: var(--color-lichen-100);
  }

  /* ---- What it does not do ---- */
  section.auto-scope {
    padding-block: var(--space-section-gap);
    background: var(--color-wash);
  }

  .auto-scope__grid {
    display: grid;
    gap: var(--space-6);
  }

  .auto-scope__list {
    --node: 1.15rem;
    display: grid;
  }

  .auto-scope__item {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) minmax(0, 1fr);
    column-gap: var(--space-4);
    align-items: start;
    padding-bottom: var(--space-5);
  }

  .auto-scope__item:last-child {
    padding-bottom: 0;
  }

  .auto-scope__node {
    position: relative;
    z-index: 1;
    width: var(--node);
    height: var(--node);
    margin-top: 0.18rem;
    color: var(--color-moss-800);
  }

  .auto-scope__stem {
    position: absolute;
    z-index: 0;
    left: 0;
    top: calc(0.18rem + var(--node) / 2);
    width: var(--node);
    height: 100%;
    color: var(--color-moss-800);
    opacity: 0.5;
    pointer-events: none;
  }

  .auto-scope__item p {
    margin: 0;
    max-width: 42ch;
    color: var(--color-text-soft);
    line-height: 1.55;
  }

  /* ---- Where the plan lives ---- */
  section.auto-plan {
    padding-top: var(--space-section-gap);
  }

  /* The measure goes on the lines, not the container, so the row keeps the
     page's left edge instead of centring. */
  .auto-plan__row {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .auto-plan__row > * {
    max-width: 42ch;
  }

  .auto-plan__title {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-display);
  }

  .auto-plan__row p {
    margin: 0;
    color: var(--color-text-soft);
  }

  @media (max-width: 599px) {
    .auto-hours__legend div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }

    .auto-hours__legend dd {
      padding-left: calc(1.5rem + var(--space-2));
    }

    .auto-hours__grid :global(.dial) {
      justify-self: center;
      width: min(100%, 18rem);
    }
  }

  /* Below the sticky layout the stem is long and narrow; a lean and a
     sprig read as a break there, so it runs straight. */
  @media (max-width: 999px) {
    .auto-flow__stem-path {
      d: path('M22 0 L 22 80');
    }

    .auto-flow__stem-path--sprig {
      display: none;
    }
  }

  @media (min-width: 1000px) {
    /* The four buds sit on one stem that runs across the row. */
    .auto-work__vine {
      position: absolute;
      top: 0.75rem;
      left: 0;
      display: block;
      width: 100%;
      height: 3rem;
      color: var(--color-moss-700);
      opacity: 0.45;
      pointer-events: none;
    }

    .auto-work__vine-path {
      stroke: currentColor;
      stroke-width: 1.3;
      stroke-linecap: round;
      vector-effect: non-scaling-stroke;
    }

    .auto-work__steps {
      position: relative;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }

    .auto-work__step {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-3);
    }

    .auto-work__bud {
      grid-row: auto;
    }

    .auto-work__step h3 {
      margin: 0;
    }

    .auto-hours__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      column-gap: clamp(2rem, 6vw, 6rem);
      justify-items: stretch;
    }

    .auto-hours__grid :global(.dial) {
      justify-self: center;
    }

    .auto-flow__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      column-gap: clamp(1.5rem, 4vw, 4rem);
      align-items: start;
    }

    /* The question stays in view while the answers pass beside it. */
    .auto-flow__intro {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
    }

    /* Title only as wide as the words, then the column gap, then the root. */
    .auto-scope__grid {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--col-gap);
      align-items: start;
    }
  }

  /* ---- Motion: drawn once, when seen. Reduced motion shows it finished. ---- */
  @media (prefers-reduced-motion: no-preference) {
    /* Stretched SVGs grow by a wipe, not a dash: Chrome miscounts dashes
       on non-scaling strokes in a stretched viewBox. */
    .auto-work__vine {
      clip-path: inset(0 100% 0 0);
      animation: auto-wipe-x 1.6s var(--ease-out) 0.15s forwards;
    }

    .auto-work__bud {
      animation: auto-bud 0.6s var(--ease-out) both;
      animation-delay: calc(0.25s + var(--i, 0) * 0.28s);
    }

    .auto-flow__stem {
      clip-path: inset(0 0 100% 0);
      animation: auto-wipe-y 1s var(--ease-out) 0.35s forwards;
    }

    .auto-flow__num {
      animation: auto-bud 0.5s var(--ease-out) 0.1s both;
    }

    .auto-flow__bubble {
      animation: auto-bubble 0.45s var(--ease-out) both;
      animation-delay: calc(0.45s + var(--at, 0) * 0.65s);
    }

    .auto-scope__seed {
      transform-box: fill-box;
      transform-origin: center;
      animation: auto-seed 0.45s var(--ease-out) both;
      animation-delay: calc(0.2s + var(--i, 0) * 0.18s);
    }

    .reveal--wait:not(.is-in) :is(.auto-work__vine, .auto-work__bud, .auto-flow__stem, .auto-flow__num, .auto-flow__bubble, .auto-scope__seed) {
      animation-play-state: paused;
    }
  }

  @keyframes auto-wipe-x {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes auto-wipe-y {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* `scale`, not `transform`, so the hover lift still applies afterwards. */
  @keyframes auto-bud {
    from {
      opacity: 0;
      scale: 0.6;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  @keyframes auto-bubble {
    from {
      opacity: 0;
      translate: 0 0.4rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes auto-seed {
    from {
      scale: 0;
    }
    to {
      scale: 1;
    }
  }
</style>
