---
/**
 * One headline, one supporting sentence, one primary action, on moss.
 * Behind it, a contour survey under a drafting grid; beside it, the root
 * network that maps the work (site, automation, care), with data moving
 * along it. A coordinates strip closes it.
 */
import Button from '@/components/ui/Button.astro';
import Contours from '@/components/visuals/Contours.astro';
import RootField from '@/components/visuals/RootField.astro';
import TechGrid from '@/components/visuals/TechGrid.astro';
import { whatsappUrl } from '@/data/site';
import { routes, useI18n } from '@/i18n';

const { t, path } = useI18n(Astro);
const whatsapp = whatsappUrl(t.meta.whatsappMessage);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__terrain" aria-hidden="true">
    <Contours preset="hero" />
  </div>
  <TechGrid focus="72% 42%" />

  <div class="container hero__layout">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">
        {t.hero.title}
        {' '}
        <em>{t.hero.titleEm}</em>
      </h1>
      <p class="hero__lede">{t.hero.lede}</p>
      <div class="hero__actions">
        {whatsapp !== null ? (
          <Button href={whatsapp} external onDark>{t.hero.writeWhatsApp}</Button>
        ) : (
          <Button href={path(routes.contacto)} onDark>{t.hero.startConversation}</Button>
        )}
      </div>
    </div>

    <div class="hero__field" data-sway aria-hidden="true">
      <RootField site={t.hero.cueSite} auto={t.hero.cueAuto} care={t.hero.cueCare} />
    </div>
  </div>

  <div class="container hero__notes">
    <p>{t.hero.place}</p>
    <p>{t.hero.offer}<span class="hero__caret" aria-hidden="true"></span></p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: var(--space-page);
    background: var(--color-dark-bg);
    color: var(--color-dark-text);
  }

  .hero__terrain {
    position: absolute;
    inset: 0;
    z-index: -1;
    --contour-color: var(--color-lichen-300);
    --contour-opacity: 0.13;
  }

  /* Mist settles at the foot of the hill, so the notes sit on calm ground. */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    z-index: -1;
    height: 40%;
    background: linear-gradient(to top, var(--color-dark-deep), transparent);
    pointer-events: none;
  }

  .hero__layout {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
    padding-bottom: var(--space-section-gap);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 40rem;
  }

  .hero__title {
    max-width: 14ch;
    font-size: clamp(2.6rem, 9vw, 3.6rem);
    font-weight: var(--weight-display);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .hero__title em {
    display: block;
    font-style: italic;
    color: var(--color-dark-accent);
  }

  .hero__lede {
    margin-top: var(--space-6);
    max-width: 34ch;
    font-size: var(--text-lg);
    line-height: 1.4;
    color: var(--color-dark-text-muted);
    text-wrap: pretty;
  }

  .hero__actions {
    margin-top: var(--space-7);
  }

  .hero__field {
    width: min(100%, 22.5rem);
    color: var(--color-lichen-200);
    --root-label: var(--color-lichen-300);
    --root-emboss: rgb(197 208 99 / 0.28);
  }

  .hero__notes {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-dark-rule);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--color-dark-text-faint);
  }

  .hero__notes p {
    max-width: none;
  }

  /* A terminal caret at the end of the line. */
  .hero__caret {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.35em;
    vertical-align: -0.15em;
    background: var(--color-dark-accent);
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__caret {
      animation: hero-caret 1.1s steps(1) infinite;
    }
  }

  @keyframes hero-caret {
    50% {
      opacity: 0;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 0.7rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title,
    .hero__lede,
    .hero__actions,
    .hero__notes {
      animation: hero-in var(--duration-slow) var(--ease-out) both;
    }

    .hero__lede { animation-delay: 0.12s; }
    .hero__actions { animation-delay: 0.24s; }
    .hero__notes { animation-delay: 0.5s; }

    .hero__field {
      animation: hero-in 1.15s var(--ease-out) 0.12s both;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-top: var(--space-7);
    }

    .hero__layout {
      gap: var(--space-6);
    }

    .hero__lede {
      margin-top: var(--space-4);
    }

    .hero__actions {
      margin-top: var(--space-5);
    }
  }

  /* Tablet: copy and the root drawing side by side, so the drawing is not
     left stranded under the button. */
  @media (min-width: 700px) and (max-width: 999px) {
    .hero__layout {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      column-gap: var(--space-6);
      align-items: center;
    }

    .hero__title {
      font-size: clamp(2.5rem, 5.9vw, 3.4rem);
    }

    .hero__field {
      width: 100%;
      justify-self: end;
    }
  }

  @media (min-width: 1000px) {
    .hero {
      min-height: min(52rem, calc(100svh - var(--header-height)));
      display: flex;
      flex-direction: column;
    }

    .hero__layout {
      flex: 1;
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.9fr);
      column-gap: clamp(3rem, 6vw, 6.5rem);
      align-items: center;
    }

    .hero__field {
      width: min(100%, 32rem);
      justify-self: end;
    }

    .hero__title {
      font-size: clamp(3.4rem, 5vw, 5.4rem);
    }
  }
</style>
