---
/**
 * Home: where we start. A statement, the situation in three lines, who it
 * is for, and four outcomes, each with a drawn glyph.
 */
import Plate from '@/components/ui/Plate.astro';
import LineGlyph, { type GlyphName } from '@/components/visuals/LineGlyph.astro';
import { useI18n } from '@/i18n';

const { t } = useI18n(Astro);
/** Same order as `positioning.outcomes`: after hours, found, appointments, paid. */
const outcomeGlyphs: GlyphName[] = ['night', 'pin', 'calendar', 'card'];
---

<section class="section positioning" aria-labelledby="positioning-title">
  <div class="container positioning__grid">
    <div class="positioning__head reveal">
      <Plate label={t.positioning.eyebrow} />
      <h2 class="positioning__statement" id="positioning-title">
        {t.positioning.statement}
        {' '}
        <em>{t.positioning.statementEm}</em>
      </h2>
    </div>

    <div class="positioning__body reveal">
      <p class="positioning__aside">{t.positioning.p1}</p>
      <p>{t.positioning.p2}</p>
      <p class="positioning__aside">{t.positioning.p3}</p>
    </div>

    <aside class="positioning__index reveal" aria-labelledby="positioning-audience">
      <h3 class="label positioning__index-title" id="positioning-audience">{t.positioning.audienceTitle}</h3>
      <ul class="positioning__index-list">
        {t.positioning.audiences.map((audience) => <li>{audience}</li>)}
      </ul>
    </aside>
  </div>

  <div class="container">
    <ol class="outcomes reveal" aria-label={t.positioning.outcomesLabel}>
      {t.positioning.outcomes.map((outcome, index) => (
        <li style={`--i:${index}`}>
          <LineGlyph
            name={outcomeGlyphs[index] ?? 'night'}
            class="glyph--draw outcomes__glyph"
            delay={0.2 + index * 0.2}
          />
          <p>{outcome}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .positioning__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: var(--space-7);
    align-items: start;
  }

  .positioning__head {
    grid-column: 1 / 11;
    display: grid;
    gap: var(--space-4);
  }

  .positioning__statement {
    font-size: var(--text-3xl);
    line-height: var(--leading-snug);
  }

  .positioning__statement em {
    font-style: italic;
    color: var(--color-clay);
  }

  .positioning__body {
    grid-column: 1 / 7;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: var(--color-text-soft);
  }

  .positioning__body p {
    max-width: 48ch;
    font-size: var(--text-md);
  }

  .positioning__index {
    grid-column: 8 / 13;
  }

  .positioning__index-title {
    margin-bottom: var(--space-3);
  }

  .positioning__index-list {
    border-top: 1px solid var(--color-rule-strong);
    font-size: var(--text-sm);
  }

  .positioning__index-list li {
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--color-rule);
  }

  /* Four outcomes, each led by its glyph. */
  .outcomes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: var(--space-7);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-wash-leaf);
  }

  .outcomes li {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-5) var(--space-7);
  }

  .outcomes li + li {
    border-left: 1px solid var(--color-rule-strong);
  }

  .outcomes li :global(.outcomes__glyph) {
    --glyph-size: 2.75rem;
    transition: rotate var(--duration-base) var(--ease-out);
  }

  .outcomes li:hover :global(.outcomes__glyph) {
    rotate: -6deg;
  }

  .outcomes p {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  @media (max-width: 1100px) {
    .positioning__head {
      grid-column: 1 / -1;
    }

    .positioning__body {
      grid-column: 1 / 7;
    }

    .positioning__index {
      grid-column: 7 / 13;
    }

    .outcomes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .outcomes li:nth-child(3) {
      border-left: 0;
    }

    .outcomes li:nth-child(n + 3) {
      border-top: 1px solid var(--color-rule-strong);
    }
  }

  @media (max-width: 700px) {
    .positioning__body,
    .positioning__index {
      grid-column: 1 / -1;
    }

    .outcomes {
      grid-template-columns: minmax(0, 1fr);
    }

    .outcomes li + li {
      border-left: 0;
      border-top: 1px solid var(--color-rule-strong);
    }

    .outcomes li {
      padding: var(--space-5);
    }
  }
</style>
