---
/**
 * The process page: five stages on one growing stem, from seed to tree.
 * Each stage has a small scene beside it (scenes/process/*). Scenes are
 * decorative; the step text carries the meaning.
 *
 * Every drawing runs once, when its stage is seen. Reduced motion, or no
 * motion script, shows the finished state.
 */
import BuildScene from '@/components/scenes/process/BuildScene.astro';
import ChatScene from '@/components/scenes/process/ChatScene.astro';
import LaunchScene from '@/components/scenes/process/LaunchScene.astro';
import OwnershipDeed from '@/components/scenes/process/OwnershipDeed.astro';
import ProposalScene from '@/components/scenes/process/ProposalScene.astro';
import RingsScene from '@/components/scenes/process/RingsScene.astro';
import '@/components/scenes/process/keyframes.css';
import LineGlyph, { type GlyphName } from '@/components/visuals/LineGlyph.astro';
import { useI18n } from '@/i18n';

const { t } = useI18n(Astro);
const growth: GlyphName[] = ['seed', 'sprout', 'sapling', 'young', 'tree'];
---

<section class="section section--page process" aria-labelledby="process-steps-title">
  <div class="container">
    <h2 class="sr-only" id="process-steps-title">{t.process.stepsTitle}</h2>
    <ol class="grow">
      {t.process.steps.map((step, index) => (
        <li class:list={['grow__step', 'reveal', { 'grow__step--flip': index % 2 === 1 }]}>
          <span class="grow__stem" aria-hidden="true"></span>
          <svg class="grow__leaf" viewBox="0 0 24 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M1 13 C 5 4 13 1 23 1 C 20 9 12 13 1 13 Z M1 13 C 8 9 14 6 19 3.5" />
          </svg>
          <div class="grow__node" aria-hidden="true">
            <LineGlyph name={growth[index] ?? 'seed'} class="glyph--draw grow__glyph" delay={0.25} />
          </div>

          <div class="grow__copy">
            <h3 class="grow__title">{step.title}</h3>
            <p class="grow__text">{step.text}</p>
          </div>

          <div class="grow__scene" aria-hidden="true">
            {index === 0 && <ChatScene />}
            {index === 1 && <ProposalScene />}
            {index === 2 && <BuildScene />}
            {index === 3 && <LaunchScene />}
            {index === 4 && <RingsScene />}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<OwnershipDeed />

<style>
  /* ---- The stem ---- */
  .grow {
    --node: 4.25rem;
    display: grid;
  }

  .grow__step {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) minmax(0, 1fr);
    grid-template-areas:
      'node copy'
      '. scene';
    column-gap: var(--space-5);
    row-gap: var(--space-5);
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  .grow__step:last-child {
    padding-bottom: 0;
  }

  .grow__stem {
    position: absolute;
    z-index: 0;
    top: calc(var(--node) / 2);
    left: calc(var(--node) / 2 - 1px);
    width: 2px;
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(to bottom, var(--color-moss-700), color-mix(in srgb, var(--color-moss-700) 55%, transparent));
    opacity: 0.5;
  }

  .grow__step:last-child .grow__stem,
  .grow__step:last-child .grow__leaf {
    display: none;
  }

  /* One leaf on each stretch of stem, alternating sides. */
  .grow__leaf {
    position: absolute;
    z-index: 0;
    top: calc(var(--node) + 45%);
    left: calc(var(--node) / 2);
    width: 1.4rem;
    color: var(--color-moss-700);
    transform-origin: 0 100%;
    rotate: -18deg;
  }

  /* Mirrored with `transform`, so the pop-in `scale` stays free. */
  .grow__step--flip .grow__leaf {
    transform: scaleX(-1);
    rotate: 18deg;
  }

  .grow__leaf path {
    fill: var(--color-lichen-100);
    stroke: currentColor;
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .grow__node {
    grid-area: node;
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border: 1px solid var(--color-rule-strong);
    border-radius: 50%;
    background: var(--color-bg);
    box-shadow: 0 0 0 6px var(--color-bg);
  }

  .grow__step:last-child .grow__node {
    border-color: var(--color-moss-700);
  }

  .grow__node :global(.grow__glyph) {
    --glyph-size: 3rem;
  }

  .grow__copy {
    grid-area: copy;
    align-self: center;
    max-width: 32rem;
  }

  .grow__title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
    line-height: 1.1;
  }

  .grow__text {
    margin: 0;
    max-width: 46ch;
    color: var(--color-text-soft);
    font-size: var(--text-md);
  }

  .grow__scene {
    grid-area: scene;
    width: min(100%, 22rem);
  }

  /* ---- Scenes, shared ---- */
  .grow__scene :global(.scene) {
    position: relative;
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-lg);
    background: none;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .grow__scene :global(.scene__tag) {
    align-self: flex-start;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (min-width: 900px) {
    .grow__step {
      grid-template-columns: minmax(0, 1fr) var(--node) minmax(0, 1fr);
      grid-template-areas: 'copy node scene';
      column-gap: clamp(1.5rem, 4vw, 4rem);
      align-items: center;
    }

    .grow__step--flip {
      grid-template-areas: 'scene node copy';
    }

    .grow__stem {
      left: calc(50% - 1px);
      top: 50%;
    }

    .grow__leaf {
      top: calc(100% - 1rem);
      left: 50%;
    }

    .grow__node {
      align-self: center;
    }

    .grow__copy {
      justify-self: end;
    }

    .grow__scene {
      justify-self: start;
    }

    .grow__step--flip .grow__copy {
      justify-self: start;
    }

    .grow__step--flip .grow__scene {
      justify-self: end;
    }
  }

  @media (max-width: 899px) {
    .grow__step--flip .grow__leaf {
      transform: none;
      rotate: -18deg;
    }
  }

  @media (max-width: 520px) {
    .grow {
      --node: 3.25rem;
    }

    .grow__node :global(.grow__glyph) {
      --glyph-size: 2rem;
    }

    .grow__step {
      column-gap: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .grow__stem {
      clip-path: inset(0 0 100% 0);
      animation: grow-wipe 1.4s var(--ease-out) 0.4s forwards;
    }

    .grow__leaf {
      animation: grow-pop 0.5s var(--ease-out) 1.3s both;
    }

    .grow__node {
      animation: grow-pop 0.55s var(--ease-out) 0.05s both;
    }

    :global(.reveal--wait:not(.is-in)) :is(.grow__stem, .grow__leaf, .grow__node) {
      animation-play-state: paused;
    }
  }
</style>
