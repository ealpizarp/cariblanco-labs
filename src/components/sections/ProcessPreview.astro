---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import StepList from '@/components/ui/StepList.astro';
import { useI18n } from '@/i18n';
import { routes } from '@/i18n/paths';

const { t, path } = useI18n(Astro);
---

<section class="section process-preview" aria-labelledby="process-preview-title">
  <div class="container">
    <SectionHeader
      plate
      label={t.homeProcess.label}
      title={t.homeProcess.title}
      titleId="process-preview-title"
      link={{ href: path(routes.proceso), label: t.homeProcess.seeProcess }}
    />
    <StepList />
  </div>
</section>
