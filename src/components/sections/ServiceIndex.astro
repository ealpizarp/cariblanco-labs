---
/**
 * Home: the services as one plate on moss. The three lead services are
 * drawn; monthly care, the base under all three, follows as a full-width
 * glass band with what it includes.
 * Each entry links to its place on the services page.
 */
import Plate from '@/components/ui/Plate.astro';
import Contours from '@/components/visuals/Contours.astro';
import TechGrid from '@/components/visuals/TechGrid.astro';
import ServiceSketch from '@/components/visuals/ServiceSketch.astro';
import { getServices } from '@/data/services';
import { routes, useI18n } from '@/i18n';

const { locale, t, path } = useI18n(Astro);
const services = getServices(locale);
const servicesPath = path(routes.servicios);
const lead = services.filter((service) => service.lead);
const more = services.filter((service) => !service.lead);
---

<section class="section index" aria-labelledby="services-title">
  <div class="index__terrain" aria-hidden="true">
    <Contours preset="band" />
  </div>
  <TechGrid focus="20% 30%" />

  <div class="container">
    <div class="index__head">
      <Plate label={t.homeServices.label} onDark />
      <h2 class="index__title" id="services-title">{t.homeServices.title}</h2>
      <a class="index__all" href={servicesPath}>
        <span>{t.homeServices.seeAll}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <ol class="index__lead">
      {lead.map((service) => (
        <li class="reveal">
          <a class="specimen" href={`${servicesPath}#${service.id}`}>
            {service.sketch && <ServiceSketch stage={service.sketch} class="specimen__sketch" />}
            <h3 class="specimen__name">{service.name}</h3>
            <p class="specimen__summary">{service.summary}</p>
            {t.homeServices.tags[service.id] && (
              <ul class="specimen__tags">
                {t.homeServices.tags[service.id]?.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
            <span class="specimen__more" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    <ol class="index__more">
      {more.map((service) => (
        <li class="reveal">
          <a class="base-band" href={`${servicesPath}#${service.id}`}>
            <span class="base-band__copy">
              <span class="base-band__label">{t.services.baseLabel}</span>
              <span class="index__more-name">{service.name}</span>
              <span class="index__more-summary">{service.summary}</span>
            </span>
            <ul class="base-band__includes">
              {service.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <span class="base-band__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .index {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-dark-bg);
    color: var(--color-dark-text);
  }

  .index__terrain {
    position: absolute;
    inset: 0;
    z-index: -1;
    --contour-color: var(--color-lichen-300);
    --contour-opacity: 0.14;
  }

  .index__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-4) var(--col-gap);
    margin-bottom: var(--space-7);
  }

  .index__head :global(.plate) {
    grid-column: 1 / -1;
  }

  .index__title {
    max-width: 16ch;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
  }

  .index__all {
    display: inline-flex;
    gap: var(--space-2);
    padding-block: 0.35rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-dark-accent);
    border-bottom: 1px solid currentColor;
  }

  .index__all:hover,
  .index__all:focus-visible {
    color: var(--color-lichen-200);
  }

  /* ---- Lead specimens ---- */
  .index__lead {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--col-gap);
  }

  .index__lead > li {
    display: flex;
  }

  .specimen {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: var(--space-5) var(--space-5) var(--space-6);
    background: var(--glass-moss);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-edge-dark);
    box-shadow: inset 0 1px 0 var(--glass-edge-dark);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .specimen:hover,
  .specimen:focus-visible {
    border-color: rgb(197 208 99 / 0.55);
    background: var(--color-dark-raised);
  }

  .specimen :global(.specimen__sketch) {
    width: min(100%, 15rem);
    margin: var(--space-4) auto var(--space-5);
    --sketch-ink: var(--color-lichen-200);
    --sketch-emboss: rgb(197 208 99 / 0.28);
    --sketch-leaf: rgb(197 208 99 / 0.18);
    --sketch-ground: rgb(233 232 221 / 0.06);
    --sketch-bud: var(--color-poro-400);
  }

  .specimen__name {
    font-size: var(--text-2xl);
    line-height: 1.1;
  }

  .specimen__summary {
    margin-top: var(--space-3);
    color: var(--color-dark-text-muted);
  }

  /* What it runs on, in the technical voice. */
  .specimen__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: var(--space-4);
  }

  .specimen__tags li {
    padding: 0.2rem 0.5rem;
    border: 1px solid rgb(197 208 99 / 0.28);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--color-dark-accent);
  }

  /* The arrow closes the card, under the summary. */
  .specimen__more {
    align-self: flex-end;
    margin-top: auto;
    padding-top: var(--space-4);
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--color-dark-accent);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .specimen:hover .specimen__more,
  .specimen:focus-visible .specimen__more {
    transform: translateX(4px);
  }

  /* ---- Monthly care: the base under the three, as one glass band ---- */
  .index__more {
    display: grid;
    gap: var(--col-gap);
    margin-top: var(--col-gap);
  }

  .base-band {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr) auto;
    gap: var(--space-5) clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--glass-edge-dark);
    border-radius: var(--radius-md);
    background: var(--glass-moss);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: inset 0 1px 0 var(--glass-edge-dark);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .base-band:hover,
  .base-band:focus-visible {
    border-color: rgb(197 208 99 / 0.55);
  }

  .base-band__copy {
    display: grid;
    gap: var(--space-1);
  }

  .base-band__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--color-dark-accent);
  }

  /* What care includes, as tags laid out across the band. */
  .base-band__includes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .base-band__includes li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-dark-rule);
    border-radius: var(--radius-pill);
    background: rgb(233 232 221 / 0.04);
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--color-dark-text-muted);
  }

  .base-band__arrow {
    font-size: var(--text-lg);
    color: var(--color-dark-accent);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .base-band:hover .base-band__arrow,
  .base-band:focus-visible .base-band__arrow {
    transform: translateX(4px);
  }

  .index__more-name {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.2;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .index__more a:hover .index__more-name,
  .index__more a:focus-visible .index__more-name {
    color: var(--color-dark-accent);
  }

  .index__more-summary {
    font-size: var(--text-sm);
    color: var(--color-dark-text-muted);
  }

  @media (max-width: 900px) {
    .index__head {
      grid-template-columns: minmax(0, 1fr);
    }

    .index__all {
      justify-self: start;
    }

    .index__lead {
      grid-template-columns: minmax(0, 1fr);
    }

    .base-band {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      padding: var(--space-5);
    }

    .base-band__includes {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .specimen :global(.specimen__sketch) {
      width: min(100%, 11rem);
      margin-block: var(--space-2) var(--space-4);
    }
  }
</style>
