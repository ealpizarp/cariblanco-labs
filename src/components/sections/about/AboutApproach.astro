---
/**
 * About page, part 1: why Pizote Labs works the way it does, with the two
 * founders as formal portrait cards.
 */
import { site } from '@/data/site';
import FounderPortraits from '@/components/visuals/FounderPortraits.astro';
import { PAW_PRINT, PAW_VIEWBOX } from '@/components/visuals/paw';
import { interpolate, useI18n } from '@/i18n';

const { t } = useI18n(Astro);
const about = t.about;
/** "A", "A y B", "A, B y C". */
const names = site.founders.map((person) => person.name);
const founderNames =
  names.length < 2 ? (names[0] ?? '') : `${names.slice(0, -1).join(', ')} ${about.and} ${names.at(-1) ?? ''}`;
---

<section class="section section--page story" aria-labelledby="story-approach">
  <div class="container story__approach">
    <div class="story__plate reveal">
      <FounderPortraits />
    </div>

    <div class="story__copy reveal">
      <h2 id="story-approach">{about.statementTitle}</h2>
      <p class="story__lead">{about.statement}</p>
      <p class="story__more">{about.statementMore}</p>
      <p class="story__origin">
        <span class="story__seal" aria-hidden="true">
          <svg viewBox={PAW_VIEWBOX} set:html={PAW_PRINT} />
        </span>
        {interpolate(about.origin, { name: founderNames })}
      </p>
    </div>
  </div>
</section>

<style>
  /* ---- Approach: the photo on a cut of growth rings ---- */
  .story__approach {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: var(--space-6);
    align-items: end;
  }

  .story__plate {
    grid-column: 1 / 6;
  }

  .story__copy {
    grid-column: 7 / 13;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .story__copy h2,
  .story-terms h2 {
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
  }

  .story__copy h2,
  .story-terms h2 {
    max-width: 22ch;
  }

  .story__lead {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-heading);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-display);
    color: var(--color-text);
    max-width: 28ch;
  }

  .story__more {
    max-width: 42ch;
    font-size: var(--text-md);
    color: var(--color-text-soft);
  }

  .story__origin {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .story__seal {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-pill);
    color: var(--color-moss-800);
  }

  /* The founders' mark: a paw print, like the deed's stamp. */
  .story__seal svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: currentColor;
  }

  @media (max-width: 900px) {
    .story__plate,
    .story__copy {
      grid-column: 1 / -1;
    }

    .story__copy {
      order: -1;
    }

    .story__plate {
      max-width: 34rem;
    }
  }
</style>
