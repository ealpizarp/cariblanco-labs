---
/**
 * About page, part 3: how we work together, as one vine that grows across
 * the five process steps. Every drawing runs once when seen; reduced motion
 * shows it finished.
 */
import { routes, useI18n } from '@/i18n';

const { t, path } = useI18n(Astro);
const about = t.about;
const steps = t.process.steps;
---

<section class="section section--page story-together" aria-labelledby="story-together-title">
  <div class="container">
    <div class="story-together__head">
      <p class="eyebrow">{about.togetherLabel}</p>
      <h2 id="story-together-title">{about.togetherTitle}</h2>
      <p class="story-together__text">{about.together}</p>
    </div>

    <div class="story-vine reveal">
      <svg class="story-vine__line" viewBox="0 0 1000 80" preserveAspectRatio="none" fill="none" aria-hidden="true">
        <path
          class="story-vine__stem"
          pathLength="100"
          d="M0 44 C 60 20 120 30 100 40 S 220 66 300 40 S 420 14 500 40 S 620 66 700 40 S 820 14 900 40 S 980 58 1000 36"
        />
        <path class="story-vine__leaf" d="M200 46 C 214 62 236 64 250 58 C 238 46 220 42 200 46 Z" />
        <path class="story-vine__leaf" d="M600 34 C 614 18 636 16 650 22 C 638 34 620 38 600 34 Z" />
        <path class="story-vine__leaf story-vine__leaf--late" d="M800 46 C 812 62 832 66 846 60 C 836 48 818 42 800 46 Z" />
      </svg>
      <ol class="story-vine__steps" aria-label={t.process.stepsTitle}>
        {steps.map((step, index) => (
          <li class="story-vine__step" style={`--i:${index}`}>
            <span class="story-vine__bud" aria-hidden="true"></span>
            <span class="story-vine__title">{step.title}</span>
          </li>
        ))}
      </ol>
    </div>

    <a class="link-underline story-together__link" href={path(routes.proceso)}>{t.homeProcess.seeProcess}</a>
  </div>
</section>

<style>
  .story__copy h2,
  .story-terms h2,
  .story-together h2 {
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
  }

  .story-together h2 {
    max-width: 20ch;
  }

  /* ---- With you: the process as one vine ---- */
  .story-together {
    padding-block: var(--space-section-gap);
  }

  .story-together__head {
    display: grid;
    gap: var(--space-4);
  }

  .story-together__text {
    max-width: 42ch;
    font-size: var(--text-md);
    color: var(--color-text-soft);
  }

  .story-vine {
    position: relative;
    margin-top: var(--space-7);
  }

  .story-vine__line {
    display: none;
  }

  .story-vine__steps {
    display: grid;
    gap: var(--space-4);
    border-left: 1px solid var(--color-rule-strong);
    margin-left: 1.15rem;
    padding-left: var(--space-5);
  }

  .story-vine__step {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .story-vine__bud {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.3rem;
    height: 2.3rem;
    margin-left: calc(-1 * (var(--space-5) + 1.15rem + 0.5px));
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    font-style: italic;
  }

  /* A seed in each bud. */
  .story-vine__bud::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-lichen-300);
  }

  .story-vine__step:nth-child(even) .story-vine__bud::after {
    background: var(--color-clay);
  }

  .story-vine__step:nth-child(even) .story-vine__bud {
    background: var(--color-surface);
    color: var(--color-primary-strong);
    border: 1px solid var(--color-rule-strong);
  }

  .story-vine__title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.25;
  }

  .story-together__link {
    display: inline-block;
    margin-top: var(--space-6);
    color: var(--color-primary-strong);
  }

  @media (min-width: 700px) {
    /* The stem runs through the buds; the step names sit under them. */
    .story-vine__line {
      position: absolute;
      top: 0;
      left: 0;
      display: block;
      width: 100%;
      height: 5rem;
      color: var(--color-moss-700);
      pointer-events: none;
    }

    .story-vine__stem {
      stroke: currentColor;
      stroke-width: 1.3;
      stroke-linecap: round;
      vector-effect: non-scaling-stroke;
      opacity: 0.55;
    }

    .story-vine__leaf {
      fill: var(--color-lichen-100);
      stroke: currentColor;
      stroke-width: 1;
      vector-effect: non-scaling-stroke;
      opacity: 0.8;
    }

    .story-vine__steps {
      position: relative;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--col-gap);
      margin: 0;
      padding: 0;
      border-left: 0;
    }

    .story-vine__step {
      flex-direction: column;
      align-items: center;
      gap: var(--space-4);
      padding-top: 1.35rem;
      text-align: center;
    }

    .story-vine__bud {
      width: 2.6rem;
      height: 2.6rem;
      margin-left: 0;
      font-size: var(--text-md);
      box-shadow: 0 0 0 0.4rem var(--color-bg);
    }

    .story-vine__title {
      max-width: 12ch;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* A wipe, not a dash: Chrome miscounts dashes on non-scaling strokes
       in a stretched viewBox. */
    .story-vine__line {
      clip-path: inset(0 100% 0 0);
      animation: story-wipe 2.2s var(--ease-out) 0.1s forwards;
    }

    .story-vine__leaf {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: left center;
      animation: story-leaf 0.6s var(--ease-out) 1.1s forwards;
    }

    .story-vine__leaf--late {
      animation-delay: 1.8s;
    }

    .story-vine__bud {
      animation: story-bud 0.5s var(--ease-out) both;
      animation-delay: calc(0.3s + var(--i, 0) * 0.38s);
    }

    .story-vine__title {
      animation: story-rise 0.6s var(--ease-out) both;
      animation-delay: calc(0.45s + var(--i, 0) * 0.38s);
    }

    .reveal--wait:not(.is-in) :is(.story-vine__line, .story-vine__leaf, .story-vine__bud, .story-vine__title) {
      animation-play-state: paused;
    }
  }

  @keyframes story-wipe {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes story-leaf {
    from {
      opacity: 0;
      scale: 0.2;
    }
    to {
      opacity: 0.8;
      scale: 1;
    }
  }

  @keyframes story-bud {
    from {
      opacity: 0;
      scale: 0.5;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  @keyframes story-rise {
    from {
      opacity: 0;
      translate: 0 0.6rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
