---
/**
 * Automation page, part 2 (the assistant in detail): when it works. A 24-hour dial of your hours
 * against the assistant's, on moss with a contour survey behind it.
 * At the foot of the section a cariblanco sleeps on its branch: the
 * assistant has the night.
 */
import Plate from '@/components/ui/Plate.astro';
import Contours from '@/components/visuals/Contours.astro';
import HoursDial from '@/components/visuals/HoursDial.astro';
import Cariblanco from '@/components/visuals/Cariblanco.astro';
import { useI18n } from '@/i18n';

const { t } = useI18n(Astro);
const hours = t.automation.hours;
---

<section id="asistente" class="section auto-hours" aria-labelledby="auto-hours-title">
  <div class="auto-hours__terrain" aria-hidden="true">
    <Contours preset="band" />
  </div>
  <div class="container auto-hours__grid">
    <div class="auto-hours__copy">
      <Plate numeral="24 h" label={hours.label} onDark />
      <h2 class="auto-hours__title" id="auto-hours-title">{hours.title}</h2>
      <p class="auto-hours__text">{hours.text}</p>
      <dl class="auto-hours__legend">
        <div>
          <dt><span class="auto-hours__key auto-hours__key--open" aria-hidden="true"></span>{hours.open}</dt>
          <dd>{hours.openValue}</dd>
        </div>
        <div>
          <dt><span class="auto-hours__key auto-hours__key--assistant" aria-hidden="true"></span>{hours.assistant}</dt>
          <dd>{hours.assistantValue}</dd>
        </div>
        <div>
          <dt><span class="auto-hours__key auto-hours__key--arrival" aria-hidden="true"></span>{hours.arrival}</dt>
          <dd>{hours.arrivalValue}</dd>
        </div>
      </dl>
    </div>
    <HoursDial />
  </div>
  <Cariblanco pose="sleep" onDark class="auto-hours__cariblanco" />
</section>

<style>
  /* ---- After hours: the dial on moss ---- */
  .auto-hours {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-section-gap);
    background: var(--color-dark-bg);
    color: var(--color-dark-text);
  }

  .auto-hours__terrain {
    position: absolute;
    inset: 0;
    z-index: -1;
    --contour-color: var(--color-lichen-300);
    --contour-opacity: 0.07;
  }

  .auto-hours :global(.auto-hours__cariblanco) {
    position: absolute;
    bottom: -0.15rem;
    right: max(var(--gutter), calc(50% - 41rem));
    width: clamp(8rem, 13vw, 12rem);
    opacity: 0.92;
  }

  .auto-hours__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    justify-items: start;
  }

  .auto-hours__copy {
    display: grid;
    gap: var(--space-4);
  }

  .auto-hours__title {
    max-width: 16ch;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
  }

  .auto-hours__text {
    max-width: 44ch;
    color: var(--color-dark-text-muted);
  }

  .auto-hours__legend {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-dark-rule);
  }

  .auto-hours__legend div {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .auto-hours__legend dt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--weight-semibold);
  }

  .auto-hours__legend dd {
    margin: 0;
    color: var(--color-dark-text-muted);
  }

  .auto-hours__key {
    flex: none;
    width: 1.5rem;
    height: 0.5rem;
    border-radius: var(--radius-pill);
  }

  .auto-hours__key--open {
    background: var(--color-dark-text);
  }

  .auto-hours__key--assistant {
    height: 0;
    border-top: 3px dotted var(--color-dark-accent);
    border-radius: 0;
  }

  .auto-hours__key--arrival {
    width: 0.6rem;
    height: 0.6rem;
    margin-inline: 0.45rem;
    background: var(--color-dark-emphasis);
  }

  @media (max-width: 599px) {
    .auto-hours__legend div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }

    .auto-hours__legend dd {
      padding-left: calc(1.5rem + var(--space-2));
    }

    .auto-hours__grid :global(.dial) {
      justify-self: center;
      width: min(100%, 18rem);
    }
  }

  /* Tablet and up: the copy and the dial side by side. */
  @media (min-width: 700px) {
    .auto-hours__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      column-gap: clamp(2rem, 6vw, 6rem);
      justify-items: stretch;
    }

    .auto-hours__grid :global(.dial) {
      justify-self: center;
    }
  }
</style>
