---
/**
 * Automation page, part 4: what it does not do.
 */
import { useI18n } from '@/i18n';

const { t } = useI18n(Astro);
---

<section class="section section--page auto-scope" aria-labelledby="automation-scope-title">
  <div class="container auto-scope__grid">
    <header class="auto-block__intro">
      <h2 class="auto-block__title" id="automation-scope-title">{t.automation.doesNot}</h2>
    </header>

    <ul class="auto-scope__list reveal">
      {
        t.automation.doesNotItems.map((item, index) => (
          <li class="auto-scope__item" style={`--i:${index}`}>
            <svg class="auto-scope__node" viewBox="0 0 16 16" width="18" height="18" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="5.25" stroke="currentColor" stroke-width="1.25" />
              <circle class="auto-scope__seed" cx="8" cy="8" r="2.1" fill="var(--color-clay)" />
            </svg>
            {index < t.automation.doesNotItems.length - 1 && (
              <svg class="auto-scope__stem" viewBox="0 0 18 80" width="18" preserveAspectRatio="none" fill="none" aria-hidden="true">
                <path
                  d={index % 2 === 0 ? 'M9 0 C 5 26 12 54 9 80' : 'M9 0 C 13 26 6 54 9 80'}
                  stroke="currentColor"
                  stroke-width="1.25"
                  stroke-linecap="round"
                  vector-effect="non-scaling-stroke"
                />
              </svg>
            )}
            <p>{item}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ---- What it does not do ---- */
  section.auto-scope {
    padding-block: var(--space-section-gap);
    background: var(--color-wash);
  }

  .auto-scope__grid {
    display: grid;
    gap: var(--space-6);
  }

  .auto-scope__list {
    --node: 1.15rem;
    display: grid;
  }

  .auto-scope__item {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) minmax(0, 1fr);
    column-gap: var(--space-4);
    align-items: start;
    padding-bottom: var(--space-5);
  }

  .auto-scope__item:last-child {
    padding-bottom: 0;
  }

  .auto-scope__node {
    position: relative;
    z-index: 1;
    width: var(--node);
    height: var(--node);
    margin-top: 0.18rem;
    color: var(--color-moss-800);
  }

  .auto-scope__stem {
    position: absolute;
    z-index: 0;
    left: 0;
    top: calc(0.18rem + var(--node) / 2);
    width: var(--node);
    height: 100%;
    color: var(--color-moss-800);
    opacity: 0.5;
    pointer-events: none;
  }

  .auto-scope__item p {
    margin: 0;
    max-width: 42ch;
    color: var(--color-text-soft);
    line-height: 1.55;
  }

  @media (min-width: 1000px) {
    /* Title only as wide as the words, then the column gap, then the root. */
    .auto-scope__grid {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--col-gap);
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .auto-scope__seed {
      transform-box: fill-box;
      transform-origin: center;
      animation: auto-seed 0.45s var(--ease-out) both;
      animation-delay: calc(0.2s + var(--i, 0) * 0.18s);
    }

    .reveal--wait:not(.is-in) :is(.auto-work__vine, .auto-work__bud, .auto-flow__stem, .auto-flow__num, .auto-flow__bubble, .auto-scope__seed) {
      animation-play-state: paused;
    }
  }

  @keyframes auto-seed {
    from {
      scale: 0;
    }
    to {
      scale: 1;
    }
  }
</style>
