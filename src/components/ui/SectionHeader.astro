---
/**
 * Eyebrow plus section title on the 12-column grid. The heading is always an
 * <h2>: sections are children of the page's <h1>.
 */
import Plate from '@/components/ui/Plate.astro';

interface Props {
  label: string;
  /** Shows the label as a field-guide plate, with a leading rule (home page). */
  plate?: boolean;
  title: string;
  /** Element id for the heading, referenced by the section's aria-labelledby. */
  titleId: string;
  /** Optional link shown at the end of the header row, e.g. "Ver todos". */
  link?: { href: string; label: string };
}

const { label, plate, title, titleId, link } = Astro.props;
---

<div class="section-header reveal">
  {plate ? <Plate label={label} class="eyebrow" /> : <p class="eyebrow">{label}</p>}
  <h2 class="section-header__title" id={titleId}>{title}</h2>
  {link && (
    <a class="section-header__link" href={link.href}>
      <span>{link.label}</span>
      <span aria-hidden="true">→</span>
    </a>
  )}
</div>

<style>
  .section-header {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: var(--space-4);
    align-items: start;
    margin-bottom: var(--space-6);
  }

  .eyebrow,
  .section-header :global(.plate) {
    grid-column: 1 / -1;
    grid-row: 1;
    align-self: start;
    padding-top: 0;
  }

  .section-header__title {
    grid-column: 1 / 10;
    grid-row: 2;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
  }

  .section-header__link {
    grid-column: 1 / -1;
    grid-row: 3;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-primary-strong);
    padding: 0.35rem 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .section-header__link:hover,
  .section-header__link:focus-visible {
    color: var(--color-text);
  }

  .section-header__link span:last-child {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .section-header__link:hover span:last-child {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .section-header {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .eyebrow {
      padding-top: 0;
    }

    .section-header__link {
      justify-self: start;
    }
  }
</style>
