---
/**
 * The five working steps, each with a growth glyph (seed to tree, as on
 * the process page). Wide screens: one stem across the page with a column
 * per step; the stem is a vine. When the list scrolls into view a
 * cariblanco bounds along it from the first step to the last, slows to
 * a walk, and sits down on the vine to look at the reader.
 * Narrow: a ruled list. Glyphs draw in one after another.
 */
import LineGlyph, { type GlyphName } from '@/components/visuals/LineGlyph.astro';
import Cariblanco from '@/components/visuals/Cariblanco.astro';
import Vine from '@/components/visuals/Vine.astro';
import { useI18n } from '@/i18n';

const { t } = useI18n(Astro);
const growth: GlyphName[] = ['seed', 'sprout', 'sapling', 'young', 'tree'];
---

<ol class="steps reveal">
  <li class="steps__walker" aria-hidden="true">
    <Cariblanco pose="walk" />
  </li>
  <li class="steps__sitter" aria-hidden="true">
    <Cariblanco pose="sit" curious />
  </li>
  {t.process.steps.map((step, index) => (
    <li class="step">
      <span class="step__bud" aria-hidden="true">
        <LineGlyph name={growth[index] ?? 'seed'} class="glyph--draw" delay={0.15 + index * 0.22} />
      </span>
      <Vine span={260} sag={6} leaves={3} class="step__vine" />
      <h3 class="step__title">{step.title}</h3>
      <p class="step__text">{step.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    border-top: 2px solid var(--color-text);
  }

  .step {
    display: grid;
    grid-template-columns: 3rem minmax(0, 14rem) minmax(0, 1fr);
    column-gap: var(--col-gap);
    align-items: center;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-rule-strong);
  }

  .step__bud {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 50%;
    background: var(--color-surface);
    --glyph-size: 2.1rem;
    transition: rotate var(--duration-base) var(--ease-out);
  }

  .step:hover .step__bud {
    rotate: -8deg;
  }

  .step:last-child .step__bud {
    background: var(--color-lichen-100);
    border-color: var(--color-moss-700);
  }

  /* The vine and the cariblanco only appear on the wide stem. */
  .step :global(.step__vine),
  .steps__walker,
  .steps__sitter {
    display: none;
  }

  .step__title {
    font-size: var(--text-xl);
    line-height: 1.15;
  }

  .step__text {
    max-width: 60ch;
    color: var(--color-text-soft);
  }

  @media (max-width: 700px) {
    .step {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      column-gap: var(--space-4);
      row-gap: var(--space-2);
      align-items: start;
    }

    .step__bud {
      grid-row: 1 / 3;
      width: 2.75rem;
      height: 2.75rem;
      --glyph-size: 1.9rem;
    }

    .step__title {
      align-self: center;
    }

    .step__text {
      grid-column: 2;
      font-size: var(--text-base);
    }
  }

  /* Wide: the stem runs across through the buds; each step reads down. */
  @media (min-width: 1000px) {
    .steps {
      position: relative;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      column-gap: var(--col-gap);
      border-top: 0;
    }


    .step {
      position: relative;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      align-items: start;
      row-gap: var(--space-3);
      padding-block: 0;
      border-bottom: 0;
    }

    /* One stretch of vine from each bud to the next (rope at y 10 of its
       box, so the box starts 10/46 of its height above the stem). */
    .step :global(.step__vine) {
      display: block;
      position: absolute;
      top: 1.2rem;
      left: 3rem;
      width: calc(100% - 3rem + var(--col-gap));
      color: var(--color-moss-700);
      --vine-leaf: var(--color-lichen-100);
    }

    .step:last-child :global(.step__vine) {
      width: calc(100% - 3rem);
    }

    /* At rest, a cariblanco sits on the last stretch of vine (seat 1.45
       widths down its box, on the stem line at 1.5rem), under the middle
       of where the walker's body ends up. The walker (feet 80/90 down its
       box) only appears when there is a walk to show; see below. */
    .steps {
      container-type: inline-size;
      --walk-w: 4.6rem;
    }

    .steps__walker {
      position: absolute;
      z-index: 2;
      top: calc(1.5rem - var(--walk-w) * 90 / 130 * 80 / 90);
      right: 0.4rem;
      width: var(--walk-w);
      pointer-events: none;
    }

    /* Its head matches the walker's: 1.18 x 48 units of 80 against
       0.95 x 48 of 130, so the sitter is 0.49 of the walker's width. */
    .steps__sitter {
      --sit-w: calc(var(--walk-w) * 0.49);
      display: block;
      position: absolute;
      z-index: 2;
      top: calc(1.5rem - var(--sit-w) * 1.45);
      right: calc(0.4rem + var(--walk-w) * 70 / 130 - var(--sit-w) / 2);
      width: var(--sit-w);
      pointer-events: none;
    }

    .step__bud {
      position: relative;
      z-index: 1;
      margin-bottom: var(--space-2);
      background: var(--color-bg);
      box-shadow: 0 0 0 6px var(--color-bg);
    }

    .step:last-child .step__bud {
      background: var(--color-lichen-100);
    }

    .step__title {
      font-size: var(--text-lg);
      line-height: 1.2;
    }

    .step__text {
      font-size: var(--text-base);
      line-height: 1.55;
    }
  }

  @media (min-width: 1000px) and (prefers-reduced-motion: no-preference) {
    .steps::before {
      clip-path: inset(0 100% 0 0);
      animation: steps-wipe 1.6s var(--ease-out) 0.1s forwards;
    }

    .steps:global(.reveal--wait:not(.is-in))::before {
      animation-play-state: paused;
    }
  }

  @keyframes steps-wipe {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* ---- The walk ----
     Only when the list starts below the fold (`.reveal--wait`), so there
     is an arrival to watch. Timeline, from the reveal (seconds):
       0.5 - 7.1   bounding: 22 bounds of 0.3s, covering 90% of the way;
       7.1 - 8.1   two strides of a walk, slowing to a stop;
       8.1 - 8.5   the walker hands over to the sitter, who stays.
     A bound, from the moment the front feet land (0%): the front legs
     take the weight and sweep back (to 30%), then swing forward; the
     hind legs land under the body (40%), push it off (75%), and the body
     flies, nose up then level, to the next landing. Legs turn about the
     hip; the far legs run a few hundredths behind the near ones. */
  @media (min-width: 1000px) and (prefers-reduced-motion: no-preference) {
    .steps.reveal--wait .steps__walker {
      display: block;
      translate: calc(-100cqw + var(--walk-w) + 3.6rem) 0;
    }

    .steps.reveal--wait .steps__sitter {
      opacity: 0;
    }

    .steps.reveal--wait.is-in .steps__walker {
      animation:
        steps-travel 7.6s linear 0.5s both,
        steps-leave 0.4s ease-out 8.1s forwards;
    }

    .steps.reveal--wait.is-in .steps__sitter {
      transform-origin: 50% 77%;
      animation: steps-settle 0.45s var(--ease-out) 8.1s both;
    }

    .steps.reveal--wait.is-in .steps__walker :global(.cb__body) {
      transform-box: fill-box;
      transform-origin: 50% 60%;
      animation:
        steps-hop 0.3s linear 0.5s 22,
        steps-sway 0.25s ease-in-out 7.1s 4 alternate;
    }

    .steps.reveal--wait.is-in .steps__walker :global(.cb__leg) {
      transform-box: fill-box;
      transform-origin: 50% 0;
    }

    /* Front legs: the far one (also trot pair a) and the near one (b). */
    .steps.reveal--wait.is-in .steps__walker :global(.cb__leg--fore.cb__leg--far) {
      animation:
        steps-fore 0.3s linear 0.53s 22,
        steps-stride 0.5s linear 7.1s 2;
    }

    .steps.reveal--wait.is-in .steps__walker :global(.cb__leg--fore:not(.cb__leg--far)) {
      animation:
        steps-fore 0.3s linear 0.5s 22,
        steps-stride 0.5s linear 7.35s 2;
    }

    /* Hind legs: the near one (trot pair a) and the far one (b). */
    .steps.reveal--wait.is-in .steps__walker :global(.cb__leg--hind:not(.cb__leg--far)) {
      animation:
        steps-hind 0.3s linear 0.5s 22,
        steps-stride 0.5s linear 7.1s 2;
    }

    .steps.reveal--wait.is-in .steps__walker :global(.cb__leg--hind.cb__leg--far) {
      animation:
        steps-hind 0.3s linear 0.53s 22,
        steps-stride 0.5s linear 7.35s 2;
    }

    .steps.reveal--wait.is-in .steps__walker :global(.cb__tail) {
      transform-box: view-box;
      transform-origin: 24px 50px;
      animation: steps-flick 0.3s ease-in-out 0.5s 22;
    }
  }

  /* Bounding at an even speed for 90% of the way, then two slowing
     strides for the last 10%. */
  @keyframes steps-travel {
    0% { translate: calc(-100cqw + var(--walk-w) + 3.6rem) 0; }
    86.8% { translate: calc((-100cqw + var(--walk-w) + 3.6rem) * 0.1) 0; animation-timing-function: cubic-bezier(0.2, 0.6, 0.35, 1); }
    100% { translate: 0 0; }
  }

  /* The body over one bound (user units; one is about half a pixel). */
  @keyframes steps-hop {
    0% { translate: 0 2px; rotate: 3deg; animation-timing-function: ease-in-out; }
    40% { translate: 0 3px; rotate: -1deg; animation-timing-function: ease-in; }
    75% { translate: 0 0; rotate: -5deg; animation-timing-function: ease-out; }
    90% { translate: 0 -13px; rotate: -1deg; animation-timing-function: ease-in; }
    100% { translate: 0 2px; rotate: 3deg; }
  }

  /* The small rise and fall of a walk. */
  @keyframes steps-sway {
    from { translate: 0 0; }
    to { translate: 0 -4px; }
  }

  @keyframes steps-fore {
    0% { rotate: -22deg; scale: 1 1; }
    30% { rotate: 30deg; scale: 1 1; }
    55% { rotate: 6deg; scale: 1 0.82; }
    80% { rotate: -36deg; scale: 1 0.95; }
    100% { rotate: -22deg; scale: 1 1; }
  }

  @keyframes steps-hind {
    0% { rotate: -4deg; scale: 1 0.86; }
    40% { rotate: -30deg; scale: 1 1; }
    75% { rotate: 34deg; scale: 1 1; }
    88% { rotate: 22deg; scale: 1 0.84; }
    100% { rotate: -4deg; scale: 1 0.86; }
  }

  /* A walking stride: planted and swept back, then lifted and brought
     forward. */
  @keyframes steps-stride {
    0% { rotate: -16deg; scale: 1 1; }
    50% { rotate: 16deg; scale: 1 1; }
    75% { rotate: 0deg; scale: 1 0.84; }
    100% { rotate: -16deg; scale: 1 1; }
  }

  @keyframes steps-flick {
    0%, 100% { rotate: -5deg; }
    75% { rotate: 9deg; }
  }

  @keyframes steps-leave {
    to { opacity: 0; }
  }

  /* Sitting down: it fades in a little tall and settles onto its seat. */
  @keyframes steps-settle {
    from { opacity: 0; scale: 1 1.08; }
    to { opacity: 1; scale: 1 1; }
  }
</style>
