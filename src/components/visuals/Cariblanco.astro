---
/**
 * The cariblanco (white-faced capuchin): black body and long prehensile
 * tail curled at the tip, cream hood over the head and shoulders, black
 * cap with a widow's peak, bare pink face. Drawn flat, face turned out.
 *
 * Poses:
 *  - sit:   sitting, tail hanging off the front edge and curling. Seat
 *           line at y = 116 of 150. `hold` puts a leaf or a stone in its
 *           hands; `think` has it scratching its head.
 *  - hang:  hanging from a vine by its tail and one hand; the vine is at
 *           y = 10. `look` shades its eyes with the free hand; `vine`
 *           draws its own stretch of vine. `swing` rocks it.
 *  - leap:  mid-jump to the right, arms reaching, tail hooked up.
 *  - sleep: curled up asleep on its branch, tail hanging below.
 *  - peek:  head and hands over a bottom edge.
 *  - head:  the head alone, for the wordmark.
 *
 * Colours: `color` (body), `--cb-hood`, `--cb-face`, `--cb-ring` (the
 * ground colour), `--cb-vine` and `--cb-leaf`. Decorative: aria-hidden.
 * Open eyes blink now and then; nothing moves under reduced motion.
 */
import { arm, hand, head, headAt, limb } from './cariblanco-parts';

interface Props {
  pose?: 'sit' | 'hang' | 'leap' | 'sleep' | 'peek' | 'head';
  hold?: 'leaf' | 'stone';
  think?: boolean;
  look?: boolean;
  vine?: boolean;
  swing?: boolean;
  class?: string;
  /** Placement when nested inside another SVG drawing (user units). */
  x?: number;
  y?: number;
  width?: number;
  height?: number;
}

const {
  pose = 'sit',
  hold,
  think = false,
  look = false,
  vine = true,
  swing = false,
  class: className,
  x,
  y,
  width,
  height,
} = Astro.props;

const LEAF_IN_HAND =
  '<path class="cb__leaf" transform="translate(50 86) rotate(-20)" d="M0 0 C-5 -3 -6 -10 0 -14 C6 -10 5 -3 0 0 Z"/>';

/** Sitting. Arms come forward over the body to the lap, or one goes up. */
function sit(): string {
  const right = think
    ? arm('M66 56 C80 46 80 26 68 14') + hand(66, 13)
    : hold === 'stone'
      ? arm('M66 56 C80 50 84 36 78 26') + hand(78, 25) + '<ellipse class="cb__stone" cx="80" cy="18" rx="6.5" ry="5.5"/>'
      : arm('M66 56 C72 70 66 84 54 88') + hand(54, 88);
  return (
    `<g class="cb__tail">${limb('M38 108 C26 116 22 130 26 142 C29 150 38 150 38 143 C38 138 33 138 32 141', 5)}</g>` +
    '<path fill="currentColor" d="M31 54 C29 42 40 38 50 38 C60 38 71 42 69 54 L73 92 C74 106 64 114 50 114 C36 114 26 106 27 92 Z"/>' +
    '<path fill="var(--cb-hood)" d="M32 48 C37 41 63 41 68 48 C66 62 58 70 50 72 C42 70 34 62 32 48 Z"/>' +
    '<ellipse cx="37" cy="108" rx="12" ry="8" fill="currentColor"/><ellipse cx="63" cy="108" rx="12" ry="8" fill="currentColor"/>' +
    arm('M34 56 C28 70 34 84 46 88') +
    (hold === 'leaf' ? LEAF_IN_HAND : '') +
    hand(46, 88) +
    right +
    headAt(50, 27, 1.18, think ? -8 : 0)
  );
}

/** Hanging by its tail (and a hand) from a vine at y = 10. */
function hangFrom(): string {
  const free = look ? arm('M64 64 C78 58 76 40 62 27') + hand(60, 26) : arm('M64 64 C74 70 82 78 88 74') + hand(89, 73, 3.8);
  return (
    limb('M56 82 C66 70 68 46 62 26 C58 14 64 6 70 10 C75 14 70 20 66 16', 5) +
    limb('M38 58 C32 44 32 26 36 13') +
    hand(36, 12) +
    '<path fill="currentColor" d="M33 62 C31 50 41 46 50 46 C59 46 69 50 67 62 L69 90 C70 102 61 108 50 108 C39 108 30 102 31 90 Z"/>' +
    '<path fill="var(--cb-hood)" d="M34 56 C39 49 61 49 66 56 C64 69 57 76 50 78 C43 76 36 69 34 56 Z"/>' +
    limb('M42 104 C40 116 40 126 42 136') +
    limb('M58 104 C61 116 62 124 66 132') +
    headAt(50, 36, 1.15, look ? 6 : 0) +
    free
  );
}

const LEAP =
  limb('M44 50 C30 54 18 50 12 38 C6 26 12 14 22 16 C30 18 28 28 22 26', 5) +
  limb('M52 56 C40 66 28 72 16 74') +
  limb('M54 52 C42 56 30 56 18 54') +
  '<path fill="currentColor" d="M44 50 C46 38 64 32 84 34 C100 36 112 42 112 52 C112 62 98 66 82 64 C64 62 46 62 44 50 Z"/>' +
  '<path fill="var(--cb-hood)" d="M96 38 C106 38 114 44 114 54 C106 60 98 60 92 56 C90 50 91 42 96 38 Z"/>' +
  limb('M104 46 C116 40 128 32 142 26') +
  limb('M104 54 C118 54 132 50 146 44') +
  hand(143, 25, 3.8) +
  hand(147, 43, 3.8) +
  headAt(118, 34, 0.95, -12);

const SLEEP =
  `<g class="cb__tail">${limb('M66 70 C64 84 66 96 76 98 C84 99 86 90 80 88', 5)}</g>` +
  '<g class="cb__breath"><path fill="currentColor" d="M34 70 C30 50 52 34 78 36 C102 38 118 50 116 70 Z"/>' +
  '<path fill="var(--cb-hood)" d="M96 44 C110 46 120 56 118 70 L94 70 C90 62 90 50 96 44 Z"/></g>' +
  limb('M98 66 C108 66 116 64 124 66') +
  headAt(112, 54, 0.9, 8, 'shut') +
  '<path class="cb__vine" d="M0 72 C40 70 100 76 160 70"/>' +
  '<path class="cb__leaf" transform="translate(20 71) rotate(-120)" d="M0 0 C-5 -3 -6 -10 0 -14 C6 -10 5 -3 0 0 Z"/>' +
  '<path class="cb__leaf" transform="translate(140 71) rotate(110)" d="M0 0 C-5 -3 -6 -10 0 -14 C6 -10 5 -3 0 0 Z"/>' +
  '<g class="cb__z" fill="currentColor" font-family="Georgia, serif" font-style="italic">' +
  '<text x="128" y="34" font-size="11">z</text><text x="138" y="24" font-size="14">z</text></g>';

const PEEK =
  headAt(40, 36, 1.15) +
  '<g fill="currentColor" stroke="var(--cb-ring)" stroke-width="2"><rect x="20" y="49" width="15" height="14" rx="7"/><rect x="45" y="49" width="15" height="14" rx="7"/></g>';

const art = {
  sit: sit(),
  hang: hangFrom(),
  leap: LEAP,
  sleep: SLEEP,
  peek: PEEK,
  head: head(),
}[pose];

const viewBox = {
  sit: '10 0 80 150',
  hang: '0 0 100 150',
  leap: '0 0 160 90',
  sleep: '0 20 160 90',
  peek: '0 0 80 60',
  head: '-25 -26 50 50',
}[pose];
---

<svg
  class:list={['cariblanco', `cariblanco--${pose}`, { 'cariblanco--swing': swing }, className]}
  viewBox={viewBox}
  x={x}
  y={y}
  width={width}
  height={height}
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {pose === 'hang' && vine && <path class="cb__vine" d="M0 10 C30 16 70 16 100 10" />}
  <g class="cb__body" set:html={art} />
</svg>

<style>
  .cariblanco {
    display: block;
    overflow: visible;
    --cb-hood: var(--color-paper);
    --cb-face: #e8c4ae;
    --cb-ring: var(--color-bg);
    --cb-vine: var(--color-moss-700);
    --cb-leaf: var(--color-lichen-100);
  }


  .cariblanco :global(.cb__vine) {
    fill: none;
    stroke: var(--cb-vine);
    stroke-width: 2.4;
    stroke-linecap: round;
  }

  .cariblanco :global(.cb__leaf) {
    fill: var(--cb-leaf);
    stroke: var(--cb-vine);
    stroke-width: 1;
  }

  .cariblanco :global(.cb__stone) {
    fill: var(--color-fern-400);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Now and then, a blink. */
    .cariblanco :global(.cb__eyes) {
      transform-box: fill-box;
      transform-origin: center;
      animation: cb-blink 5.5s ease-in-out infinite;
    }

    /* Rocks on its tail, pivoting where tail and hand hold the vine. */
    .cariblanco--swing :global(.cb__body) {
      transform-box: view-box;
      transform-origin: 52px 11px;
      animation: cb-swing 3.6s ease-in-out infinite;
    }

    .cariblanco--sit :global(.cb__tail) {
      transform-box: view-box;
      transform-origin: 38px 108px;
      animation: cb-tail 4s ease-in-out infinite;
    }

    .cariblanco--sleep :global(.cb__breath) {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: cb-breathe 3.2s ease-in-out infinite;
    }

    .cariblanco--sleep :global(.cb__tail) {
      transform-box: view-box;
      transform-origin: 66px 70px;
      animation: cb-tail 5s ease-in-out infinite;
    }

    .cariblanco--sleep :global(.cb__z text) {
      animation: cb-z 3.2s ease-out infinite;
    }

    .cariblanco--sleep :global(.cb__z text + text) {
      animation-delay: 1.6s;
    }
  }

  @keyframes cb-blink {
    0%, 94%, 100% { scale: 1 1; }
    96% { scale: 1 0.1; }
  }

  @keyframes cb-swing {
    0%, 100% { rotate: -7deg; }
    50% { rotate: 7deg; }
  }

  @keyframes cb-tail {
    0%, 100% { rotate: -6deg; }
    50% { rotate: 6deg; }
  }

  @keyframes cb-breathe {
    0%, 100% { scale: 1 1; }
    50% { scale: 1.015 1.06; }
  }

  @keyframes cb-z {
    0% { opacity: 0; translate: 0 6px; }
    30% { opacity: 1; }
    100% { opacity: 0; translate: 6px -10px; }
  }
</style>
