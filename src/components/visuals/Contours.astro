---
/**
 * Topographic contour lines, inline, drawing in once on load. Geometry
 * lives in `src/lib/contours.ts`. For placements that repeat on every
 * page and do not animate, use the static `/decor/contours-<preset>.svg`
 * files instead, which the browser caches once for the whole site.
 * Reduced motion shows the lines finished.
 */
import { CONTOUR_VIEWBOX, contourLines, type ContourPreset } from '@/lib/contours';

interface Props {
  preset?: ContourPreset;
  class?: string;
}

const { preset = 'hero', class: className } = Astro.props;
const lines = contourLines(preset);
---

<svg
  class:list={['contours', `contours--${preset}`, className]}
  viewBox={`0 0 ${CONTOUR_VIEWBOX.width} ${CONTOUR_VIEWBOX.height}`}
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <g class="contours__drift">
    {lines.map((line) => (
      <path
        class:list={['contours__line', { 'contours__line--index': line.index }]}
        d={line.d}
        pathLength="1"
        style={`--delay:${line.delay}s`}
      />
    ))}
  </g>
</svg>

<style>
  .contours {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: var(--contour-color, currentColor);
  }

  .contours__line {
    stroke: currentColor;
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
    opacity: var(--contour-opacity, 0.22);
  }

  .contours__line--index {
    stroke-width: 1.3;
    opacity: calc(var(--contour-opacity, 0.22) * 1.6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .contours__line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: contour-draw 2.4s var(--ease-out) var(--delay, 0s) forwards;
    }

    /* The whole survey breathes a few pixels, slowly enough not to notice. */
    .contours__drift {
      animation: contour-drift 38s ease-in-out infinite alternate;
      transform-origin: 50% 50%;
    }
  }

  @keyframes contour-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes contour-drift {
    from {
      transform: translate3d(-6px, 0, 0) rotate(-0.4deg);
    }
    to {
      transform: translate3d(8px, -6px, 0) rotate(0.5deg);
    }
  }
</style>
