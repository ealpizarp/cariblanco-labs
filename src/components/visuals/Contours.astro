---
/**
 * Topographic contour lines, like the survey of a forested hillside.
 * The rings are computed here at build time from a few "peaks", so every
 * placement gets its own terrain and no image is shipped.
 * Lines draw in once; reduced motion shows them finished.
 */
interface Peak {
  /** Centre, in viewBox units (0–1000 × 0–600). */
  x: number;
  y: number;
  /** Number of rings and the gap between them. */
  rings: number;
  step: number;
  /** Phase offset so peaks do not share a shape. */
  seed: number;
}

interface Props {
  preset?: 'hero' | 'band' | 'footer' | 'card' | 'rings';
  class?: string;
}

const { preset = 'hero', class: className } = Astro.props;

const presets: Record<NonNullable<Props['preset']>, Peak[]> = {
  hero: [
    { x: 760, y: 250, rings: 14, step: 34, seed: 1.3 },
    { x: 120, y: 560, rings: 9, step: 38, seed: 4.1 },
  ],
  band: [
    { x: 880, y: 120, rings: 12, step: 36, seed: 2.2 },
    { x: 180, y: 520, rings: 7, step: 40, seed: 5.6 },
  ],
  footer: [{ x: 500, y: 620, rings: 16, step: 30, seed: 3.4 }],
  card: [{ x: 820, y: 80, rings: 8, step: 46, seed: 0.7 }],
  /** One centred peak, read as the growth rings of a cut trunk. */
  rings: [{ x: 500, y: 300, rings: 11, step: 21, seed: 2.9 }],
};

/** Closed Catmull-Rom spline through the points, as cubic Bézier segments. */
function smoothClosed(points: Array<[number, number]>): string {
  const n = points.length;
  const at = (i: number): [number, number] => points[((i % n) + n) % n] ?? [0, 0];
  let d = `M${at(0)[0].toFixed(1)} ${at(0)[1].toFixed(1)}`;
  for (let i = 0; i < n; i += 1) {
    const p0 = at(i - 1);
    const p1 = at(i);
    const p2 = at(i + 1);
    const p3 = at(i + 2);
    const c1x = p1[0] + (p2[0] - p0[0]) / 6;
    const c1y = p1[1] + (p2[1] - p0[1]) / 6;
    const c2x = p2[0] - (p3[0] - p1[0]) / 6;
    const c2y = p2[1] - (p3[1] - p1[1]) / 6;
    d += ` C${c1x.toFixed(1)} ${c1y.toFixed(1)} ${c2x.toFixed(1)} ${c2y.toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
  }
  return `${d} Z`;
}

/** One ring: a wobbly ellipse whose wobble drifts a little as it widens. */
function ring(peak: Peak, k: number): string {
  const samples = 28;
  const radius = 26 + k * peak.step;
  const points: Array<[number, number]> = [];
  for (let i = 0; i < samples; i += 1) {
    const a = (i / samples) * Math.PI * 2;
    const wobble =
      1 +
      0.16 * Math.sin(3 * a + peak.seed + k * 0.22) +
      0.08 * Math.sin(5 * a - peak.seed * 1.7 + k * 0.15) +
      0.04 * Math.sin(9 * a + k * 0.4);
    const r = radius * wobble;
    points.push([peak.x + Math.cos(a) * r * 1.45, peak.y + Math.sin(a) * r * 0.82]);
  }
  return smoothClosed(points);
}

const lines = (presets[preset] ?? presets.hero).flatMap((peak, p) =>
  Array.from({ length: peak.rings }, (_, k) => ({
    d: ring(peak, k),
    /** Every fifth ring is an index contour, drawn a little heavier. */
    index: k % 5 === 4,
    delay: (p * 0.25 + k * 0.07).toFixed(2),
  })),
);
---

<svg
  class:list={['contours', `contours--${preset}`, className]}
  viewBox="0 0 1000 600"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <g class="contours__drift">
    {lines.map((line) => (
      <path
        class:list={['contours__line', { 'contours__line--index': line.index }]}
        d={line.d}
        pathLength="1"
        style={`--delay:${line.delay}s`}
      />
    ))}
  </g>
</svg>

<style>
  .contours {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: var(--contour-color, currentColor);
  }

  .contours__line {
    stroke: currentColor;
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
    opacity: var(--contour-opacity, 0.22);
  }

  .contours__line--index {
    stroke-width: 1.3;
    opacity: calc(var(--contour-opacity, 0.22) * 1.6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .contours__line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: contour-draw 2.4s var(--ease-out) var(--delay, 0s) forwards;
    }

    /* The whole survey breathes a few pixels, slowly enough not to notice. */
    .contours__drift {
      animation: contour-drift 38s ease-in-out infinite alternate;
      transform-origin: 50% 50%;
    }
  }

  @keyframes contour-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes contour-drift {
    from {
      transform: translate3d(-6px, 0, 0) rotate(-0.4deg);
    }
    to {
      transform: translate3d(8px, -6px, 0) rotate(0.5deg);
    }
  }
</style>
