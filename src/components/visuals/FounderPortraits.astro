---
/**
 * The founders, as two formal portrait cards side by side. Until real
 * photos exist, each portrait is a cariblanco sitting for it, in front of
 * an arched backdrop: round glasses for the first (software), a gear pin
 * for the second (mechatronics), heads tilted toward each other. A monkey
 * stands in for a person without inventing a likeness.
 *
 * To use photos later: give each founder in `site.founders` a portrait
 * image and render it in place of `.portrait__placeholder`.
 */
import { site } from '@/data/site';
import { useI18n } from '@/i18n';
import { head } from './cariblanco-parts';

const { t } = useI18n(Astro);
/** Job titles read "Position · Profession"; the card sets them apart. */
const founders = site.founders.map((person, index) => {
  const title = t.meta.founderJobTitles[index] ?? t.meta.founderJobTitle;
  const [position, ...rest] = title.split(' · ');
  return {
    name: person.name,
    position: position ?? title,
    profession: rest.join(' · '),
    school: person.alumniOf,
  };
});

/** A cariblanco's head and shoulders in a 120 × 150 frame, facing out. */
const bust = (detail: { head?: string; chest?: string; turn?: number }) => `
  <path class="portrait__tail" d="M28 150 C16 130 12 110 18 96 C22 86 33 88 31 96"/>
  <path fill="currentColor" d="M10 150 C12 122 30 106 60 104 C90 106 108 122 110 150 Z"/>
  <path class="portrait__chest" d="M34 108 C44 102 76 102 86 108 C86 126 74 140 60 146 C46 140 34 126 34 108 Z"/>
  <g transform="translate(60 62) rotate(${detail.turn ?? 0}) scale(1.75)">${head()}${detail.head ?? ''}</g>
  ${detail.chest ?? ''}`;

/** Round glasses, in head units: two lenses, a bridge, and the arms. */
const GLASSES =
  '<g class="portrait__glasses"><circle cx="-4.6" cy="-2.6" r="3.9"/><circle cx="4.6" cy="-2.6" r="3.9"/>' +
  '<path d="M-0.9 -2.9 Q0 -3.7 0.9 -2.9"/><path d="M-8.5 -3 L-14 -4.5"/><path d="M8.5 -3 L14 -4.5"/></g>';

/** An eight-toothed gear, worn as a pin. */
function gear(x: number, y: number, r: number): string {
  const teeth = Array.from(
    { length: 8 },
    (_, i) => `<rect x="${x - 1.6}" y="${y - r - 2.4}" width="3.2" height="4" rx=".6" transform="rotate(${i * 45} ${x} ${y})"/>`,
  ).join('');
  return `<g class="portrait__pin">${teeth}<circle cx="${x}" cy="${y}" r="${r}"/><circle class="portrait__pin-hole" cx="${x}" cy="${y}" r="${r * 0.42}"/></g>`;
}

const BACKDROP =
  '<path class="portrait__arch" d="M14 150 V64 C14 37 35 16 60 16 C85 16 106 37 106 64 V150 Z"/>' +
  '<g class="portrait__arch-lines"><path d="M22 150 V66 C22 42 40 24 60 24 C80 24 98 42 98 66 V150"/><path d="M30 150 V68 C30 48 44 32 60 32 C76 32 90 48 90 68 V150"/></g>';

/** Even portraits in glasses, head tilted one way; odd ones with the pin,
    tilted the other, tail on the other shoulder. */
const sitters = founders.map((_, index) =>
  index % 2 === 0
    ? BACKDROP + bust({ head: GLASSES, turn: -5 })
    : BACKDROP + `<g transform="translate(120 0) scale(-1 1)">${bust({ turn: -6 })}</g>` + gear(44, 124, 5),
);
---

<div class="portraits">
  {founders.map((founder, index) => (
    <figure class="portrait" style={`--i:${index}`}>
      <div class="portrait__frame">
        <svg
          class="portrait__placeholder"
          viewBox="0 0 120 150"
          aria-hidden="true"
          focusable="false"
          set:html={sitters[index]}
        />
        <span class="portrait__pending">{t.about.portraitPending}</span>
      </div>
      <figcaption class="portrait__caption">
        <span class="portrait__position">{founder.position}</span>
        <span class="portrait__name">{founder.name}</span>
        {(founder.profession || founder.school) && (
          <span class="portrait__credentials">
            {founder.profession && <span>{founder.profession}</span>}
            {founder.school && <span class="portrait__school">{founder.school}</span>}
          </span>
        )}
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .portraits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    align-items: stretch;
  }

  .portrait {
    display: flex;
    flex-direction: column;
    margin: 0;
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: 0 1px 2px rgb(27 33 20 / 0.06);
  }

  .portrait__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-mist-100);
  }

  .portrait__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-moss-800);
    --cb-hood: var(--color-paper);
    --cb-face: #e8c4ae;
  }

  .portrait__placeholder :global(.portrait__arch) {
    fill: var(--color-lichen-100);
  }

  .portrait__placeholder :global(.portrait__arch-lines) {
    fill: none;
    stroke: var(--color-fern-400);
    stroke-width: 0.6;
    opacity: 0.7;
  }

  /* The cream of the hood, down over the chest. */
  .portrait__placeholder :global(.portrait__chest) {
    fill: var(--cb-hood);
  }

  .portrait__placeholder :global(.portrait__tail) {
    fill: none;
    stroke: currentColor;
    stroke-width: 6;
    stroke-linecap: round;
  }


  .portrait__placeholder :global(.portrait__glasses) {
    fill: none;
    stroke: var(--color-moss-950);
    stroke-width: 1;
    stroke-linecap: round;
  }

  .portrait__placeholder :global(.portrait__pin) {
    fill: var(--color-clay);
  }

  .portrait__placeholder :global(.portrait__pin-hole) {
    fill: var(--color-paper);
  }

  /* A small tag in the corner, on paper so it reads over the drawing. */
  .portrait__pending {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.2rem 0.4rem;
    border-radius: var(--radius-sm);
    background: rgb(244 242 234 / 0.85);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-mono);
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text-muted);
  }

  .portrait__caption {
    display: grid;
    gap: 0.3rem;
    padding: var(--space-4);
  }

  .portrait__position {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--color-clay);
  }

  .portrait__name {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: 1.2;
  }

  .portrait__credentials {
    display: grid;
    gap: 0.1rem;
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-rule);
    font-size: var(--text-sm);
    line-height: 1.35;
    color: var(--color-text-soft);
  }

  .portrait__school {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 480px) {
    .portraits {
      gap: var(--space-3);
    }

    .portrait__caption {
      padding: var(--space-3);
    }

    .portrait__pending {
      font-size: 0.5rem;
      letter-spacing: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .portrait {
      animation: portrait-in 0.7s var(--ease-out) both;
      animation-delay: calc(0.2s + var(--i, 0) * 0.15s);
    }

    :global(.reveal--wait:not(.is-in)) .portrait {
      animation-play-state: paused;
    }
  }

  @keyframes portrait-in {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
