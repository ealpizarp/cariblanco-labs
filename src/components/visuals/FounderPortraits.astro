---
/**
 * The founders, as two formal portrait cards side by side. Until real
 * photos exist, each portrait is a plain silhouette: neutral on purpose,
 * it stands in for a person without inventing a likeness.
 *
 * To use photos later: give each founder in `site.founders` a portrait
 * image and render it in place of `.portrait__placeholder`.
 */
import { site } from '@/data/site';
import { useI18n } from '@/i18n';

const { t } = useI18n(Astro);
/** Job titles read "Position · Profession"; the card sets them apart. */
const founders = site.founders.map((person, index) => {
  const title = t.meta.founderJobTitles[index] ?? t.meta.founderJobTitle;
  const [position, ...rest] = title.split(' · ');
  return {
    name: person.name,
    position: position ?? title,
    profession: rest.join(' · '),
    school: person.alumniOf,
  };
});
---

<div class="portraits">
  {founders.map((founder, index) => (
    <figure class="portrait" style={`--i:${index}`}>
      <div class="portrait__frame">
        <svg class="portrait__placeholder" viewBox="0 0 120 150" aria-hidden="true" focusable="false">
          <circle cx="60" cy="60" r="21" />
          <path d="M18 150 C 20 114 38 96 60 96 C 82 96 100 114 102 150 Z" />
        </svg>
        <span class="portrait__pending">{t.about.portraitPending}</span>
      </div>
      <figcaption class="portrait__caption">
        <span class="portrait__position">{founder.position}</span>
        <span class="portrait__name">{founder.name}</span>
        {(founder.profession || founder.school) && (
          <span class="portrait__credentials">
            {founder.profession && <span>{founder.profession}</span>}
            {founder.school && <span class="portrait__school">{founder.school}</span>}
          </span>
        )}
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .portraits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    align-items: stretch;
  }

  .portrait {
    display: flex;
    flex-direction: column;
    margin: 0;
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: 0 1px 2px rgb(27 33 20 / 0.06);
  }

  .portrait__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-mist-100);
  }

  .portrait__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--color-moss-700);
    opacity: 0.16;
  }

  .portrait__pending {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-mono);
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text-muted);
  }

  .portrait__caption {
    display: grid;
    gap: 0.3rem;
    padding: var(--space-4);
  }

  .portrait__position {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--color-clay);
  }

  .portrait__name {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: 1.2;
  }

  .portrait__credentials {
    display: grid;
    gap: 0.1rem;
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-rule);
    font-size: var(--text-sm);
    line-height: 1.35;
    color: var(--color-text-soft);
  }

  .portrait__school {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 480px) {
    .portraits {
      gap: var(--space-3);
    }

    .portrait__caption {
      padding: var(--space-3);
    }

    .portrait__pending {
      font-size: 0.5rem;
      letter-spacing: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .portrait {
      animation: portrait-in 0.7s var(--ease-out) both;
      animation-delay: calc(0.2s + var(--i, 0) * 0.15s);
    }

    :global(.reveal--wait:not(.is-in)) .portrait {
      animation-play-state: paused;
    }
  }

  @keyframes portrait-in {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
