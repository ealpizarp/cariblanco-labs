---
/**
 * A 24-hour dial: the business's opening hours as one arc, the hours the
 * assistant covers as the rest. The hand sweeps once from opening time to
 * the moment a message arrives after hours (the same 21:47 as the chat in
 * the page header), then the message marker lights.
 * Decorative: the legend beside it carries the meaning.
 */
interface Props {
  open?: number;
  close?: number;
  /** Hour the example message arrives, as a decimal (21:47 = 21.783). */
  arrival?: number;
}

const { open = 9, close = 18, arrival = 21 + 47 / 60 } = Astro.props;

const C = 120;
const R = 92;

/** Midnight at the top, clockwise. */
const angle = (hour: number): number => (hour / 24) * 360 - 90;
const point = (hour: number, radius: number): [number, number] => {
  const a = (angle(hour) * Math.PI) / 180;
  return [C + Math.cos(a) * radius, C + Math.sin(a) * radius];
};
const arc = (from: number, to: number, radius: number): string => {
  const [x1, y1] = point(from, radius);
  const [x2, y2] = point(to, radius);
  const span = (((to - from) % 24) + 24) % 24;
  const large = span > 12 ? 1 : 0;
  return `M${x1.toFixed(2)} ${y1.toFixed(2)} A${radius} ${radius} 0 ${large} 1 ${x2.toFixed(2)} ${y2.toFixed(2)}`;
};

const ticks = Array.from({ length: 24 }, (_, hour) => {
  const major = hour % 6 === 0;
  const [x1, y1] = point(hour, R + 10);
  const [x2, y2] = point(hour, R + (major ? 20 : 15));
  return { x1, y1, x2, y2, major };
});

const labels = [0, 6, 12, 18].map((hour) => {
  const [x, y] = point(hour, R + 32);
  return { hour, x, y };
});

const [tipX, tipY] = point(arrival, R);
/** The hand is drawn pointing at midnight, then rotated into place. */
const from = (open / 24) * 360;
const to = (arrival / 24) * 360;
---

<div class="dial reveal" style={`--dial-from:${from.toFixed(2)}deg;--dial-to:${to.toFixed(2)}deg`}>
  <svg class="dial__svg" viewBox="0 0 240 240" fill="none" aria-hidden="true" focusable="false">
    <circle class="dial__face" cx={C} cy={C} r={R} />
    {ticks.map((tick) => (
      <line
        class:list={['dial__tick', { 'dial__tick--major': tick.major }]}
        x1={tick.x1.toFixed(2)}
        y1={tick.y1.toFixed(2)}
        x2={tick.x2.toFixed(2)}
        y2={tick.y2.toFixed(2)}
      />
    ))}
    {labels.map((label) => (
      <text class="dial__label" x={label.x.toFixed(2)} y={label.y.toFixed(2)}>
        {String(label.hour).padStart(2, '0')}
      </text>
    ))}

    <path class="dial__arc dial__arc--assistant" pathLength="100" d={arc(close, open, R)} />
    <path class="dial__arc dial__arc--open" pathLength="100" d={arc(open, close, R)} />

    <g class="dial__hand">
      <line x1={C} y1={C} x2={C} y2={C - R + 14} />
      <circle cx={C} cy={C} r="5" />
    </g>

    <g class="dial__arrival">
      <circle class="dial__ping" cx={tipX.toFixed(2)} cy={tipY.toFixed(2)} r="7" />
      <circle class="dial__dot" cx={tipX.toFixed(2)} cy={tipY.toFixed(2)} r="4.5" />
    </g>
  </svg>
</div>

<style>
  .dial {
    width: min(100%, 22rem);
    aspect-ratio: 1;
  }

  .dial__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .dial__face {
    fill: rgb(233 232 221 / 0.04);
    stroke: var(--color-dark-rule);
    stroke-width: 1;
  }

  .dial__tick {
    stroke: var(--color-dark-text-faint);
    stroke-width: 1;
    stroke-linecap: round;
  }

  .dial__tick--major {
    stroke: var(--color-dark-text);
    stroke-width: 1.4;
  }

  .dial__label {
    fill: var(--color-dark-text-muted);
    font-family: var(--font-sans);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .dial__arc {
    stroke-linecap: round;
  }

  .dial__arc--open {
    stroke: var(--color-dark-text);
    stroke-width: 9;
  }

  .dial__arc--assistant {
    stroke: var(--color-dark-accent);
    stroke-width: 3;
    stroke-dasharray: 0.6 2.2;
  }

  .dial__hand {
    transform-box: view-box;
    transform-origin: 120px 120px;
    transform: rotate(var(--dial-to));
  }

  .dial__hand line {
    stroke: var(--color-dark-emphasis);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .dial__hand circle {
    fill: var(--color-dark-emphasis);
  }

  .dial__dot {
    fill: var(--color-dark-emphasis);
  }

  .dial__ping {
    fill: none;
    stroke: var(--color-dark-emphasis);
    stroke-width: 1.25;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dial__arc--open {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: dial-draw 1s var(--ease-out) 0.2s forwards;
    }

    .dial__arc--assistant {
      opacity: 0;
      animation: dial-fade 0.8s var(--ease-out) 0.9s forwards;
    }

    .dial__hand {
      transform: rotate(var(--dial-from));
      animation: dial-sweep 2.2s cubic-bezier(0.65, 0, 0.35, 1) 1.1s forwards;
    }

    .dial__dot {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: center;
      animation: dial-pop 0.4s var(--ease-out) 3.3s forwards;
    }

    /* Two soft rings, like a message arriving, then it rests. */
    .dial__ping {
      transform-box: fill-box;
      transform-origin: center;
      animation: dial-ping 1.4s var(--ease-out) 3.4s 2;
    }

    .dial.reveal--wait:not(.is-in) * {
      animation-play-state: paused;
    }
  }

  @keyframes dial-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes dial-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes dial-sweep {
    from {
      transform: rotate(var(--dial-from));
    }
    to {
      transform: rotate(var(--dial-to));
    }
  }

  @keyframes dial-pop {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes dial-ping {
    from {
      opacity: 0.9;
      transform: scale(0.6);
    }
    to {
      opacity: 0;
      transform: scale(2.6);
    }
  }
</style>
