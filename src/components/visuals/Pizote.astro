---
/**
 * The pizote (white-nosed coati, Nasua narica): long upturned snout with a
 * pale tip, pale marks above and below the eye, small round ears, and a
 * ringed tail held straight up. Drawn flat, in the colour of `color`.
 *
 * Poses:
 *  - walk:  side view, tail up. `trot` animates the legs and tail.
 *  - sniff: the same, with the head down to the ground.
 *  - peek:  head, paws and tail tip over a bottom edge.
 *  - stand: up on its hind legs, looking out (a lookout).
 *  - sleep: lying down, chin on its paws, tail along the ground.
 *  - head:  the head alone, for the wordmark.
 *
 * Custom properties: `--pz-ring` (tail rings and inner ear, usually the
 * ground colour) and `--pz-mark` (face marks). Decorative: aria-hidden.
 */
import { head, TAIL } from './pizote-parts';

interface Props {
  pose?: 'walk' | 'sniff' | 'peek' | 'stand' | 'sleep' | 'head';
  trot?: boolean;
  class?: string;
  /** Placement when nested inside another SVG drawing (user units). */
  x?: number;
  y?: number;
  width?: number;
  height?: number;
}

const { pose = 'walk', trot = false, class: className, x, y, width, height } = Astro.props;
const HEAD = head();

const viewBox = {
  walk: '20 0 210 150',
  sniff: '20 0 210 150',
  peek: '20 30 170 90',
  stand: '20 4 140 192',
  sleep: '0 22 236 88',
  head: '146 58 80 60',
}[pose];
---

<svg
  class:list={['pizote', `pizote--${pose}`, { 'pizote--trot': trot }, className]}
  viewBox={viewBox}
  x={x}
  y={y}
  width={width}
  height={height}
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {pose === 'head' ? (
    <g class="pizote__head">
      <Fragment set:html={HEAD} />
    </g>
  ) : pose === 'stand' ? (
    <>
      <g class="pizote__tail" transform="translate(4 72) rotate(-24 73 81)"><Fragment set:html={TAIL} /></g>
      <g stroke="currentColor" stroke-width="12" stroke-linecap="round">
        <path d="M70 150 C68 166 67 178 66 188" /><path d="M90 150 C93 166 95 178 97 188" />
        <path d="M60 189 H72" /><path d="M92 189 H104" />
      </g>
      <path fill="currentColor" d="M58 152 C48 124 52 94 66 80 C78 68 96 68 104 84 C112 104 110 134 102 154 C94 170 66 170 58 152 Z" />
      <g stroke="currentColor" stroke-width="9" stroke-linecap="round">
        <path d="M98 98 C106 102 112 108 114 116" /><path d="M92 104 C98 110 102 116 102 124" />
      </g>
      <g transform="translate(-72 -26) rotate(-8 155 105)">
        <g class="pizote__head"><Fragment set:html={HEAD} /></g>
      </g>
    </>
  ) : pose === 'sleep' ? (
    <>
      <g class="pizote__tail">
        <path d="M58 104 C40 108 22 108 14 98 C8 90 10 80 16 72" stroke="currentColor" stroke-width="12" stroke-linecap="round" />
        <path d="M58 104 C40 108 22 108 14 98 C8 90 10 80 16 72" stroke="var(--pz-ring)" stroke-width="13" stroke-dasharray="4 9" stroke-dashoffset="-14" opacity=".75" />
      </g>
      <g class="pizote__breath">
        <path fill="currentColor" d="M48 106 C42 82 68 60 108 60 C140 60 160 72 166 92 L168 106 Z" />
      </g>
      <rect x="160" y="98" width="34" height="9" rx="4.5" fill="currentColor" />
      <g transform="translate(-2 -6) rotate(6 150 100)"><Fragment set:html={head('shut')} /></g>
      <g class="pizote__z" fill="currentColor" font-family="Georgia, serif" font-style="italic">
        <text x="186" y="52" font-size="14">z</text><text x="198" y="36" font-size="19">z</text>
      </g>
    </>
  ) : pose === 'peek' ? (
    <>
      <g transform="translate(-10 40)"><Fragment set:html={TAIL} /></g>
      <g transform="translate(-40 0) rotate(-14 160 110)">
        <Fragment set:html={HEAD} />
        <path fill="currentColor" d="M150 100 L176 104 L178 140 L146 140Z" />
      </g>
      <g fill="currentColor" stroke="var(--pz-ring)" stroke-width="2.5">
        <rect x="112" y="106" width="18" height="22" rx="9" />
        <rect x="138" y="104" width="18" height="24" rx="9" />
      </g>
    </>
  ) : (
    <>
      <g class="pizote__tail"><Fragment set:html={TAIL} /></g>
      <g stroke="currentColor" stroke-width="11" stroke-linecap="round">
        <path class="pizote__leg pizote__leg--a" d="M146 112 C148 124 150 133 151 142" />
        <path class="pizote__leg pizote__leg--b" d="M134 114 C131 125 128 133 125 142" />
        <path class="pizote__leg pizote__leg--b" d="M78 110 C74 122 72 132 71 142" />
        <path class="pizote__leg pizote__leg--a" d="M94 114 C97 125 100 133 102 142" />
      </g>
      <path
        fill="currentColor"
        d="M60 96 C58 74 82 60 112 60 C132 60 150 64 160 74 C168 84 168 104 160 114 C150 122 138 124 120 124 C92 125 70 120 63 110 C60 106 59 101 60 96 Z"
      />
      {/* The pose's tilt sits on the outer group; animations rotate the
          inner one, so a CSS transform-origin cannot move the tilt. */}
      <g transform={pose === 'sniff' ? 'rotate(36 156 92)' : undefined}>
        <g class="pizote__head"><Fragment set:html={HEAD} /></g>
      </g>
    </>
  )}
</svg>

<style>
  .pizote {
    display: block;
    overflow: visible;
    --pz-ring: var(--color-dark-bg);
    --pz-mark: var(--color-mist-50);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pizote--trot .pizote__leg {
      transform-box: fill-box;
      transform-origin: 50% 0;
      animation: pizote-step 0.7s ease-in-out infinite alternate;
    }

    .pizote--trot .pizote__leg--b {
      animation-delay: -0.7s;
    }

    .pizote--trot .pizote__tail {
      transform-box: fill-box;
      transform-origin: 70% 100%;
      animation: pizote-tail 1.4s ease-in-out infinite alternate;
    }

    .pizote--trot .pizote__head {
      transform-box: fill-box;
      transform-origin: 0% 60%;
      animation: pizote-sniff 0.7s ease-in-out infinite alternate;
    }
  }

  /* Asleep: the body rises and falls, the z's drift up. */
  @media (prefers-reduced-motion: no-preference) {
    .pizote--sleep .pizote__breath {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: pizote-breathe 3.2s ease-in-out infinite;
    }

    .pizote--sleep .pizote__z text {
      animation: pizote-z 3.2s ease-out infinite;
    }

    .pizote--sleep .pizote__z text + text {
      animation-delay: 1.6s;
    }
  }

  @keyframes pizote-breathe {
    0%, 100% { scale: 1 1; }
    50% { scale: 1.015 1.06; }
  }

  @keyframes pizote-z {
    0% { opacity: 0; translate: 0 6px; }
    30% { opacity: 1; }
    100% { opacity: 0; translate: 6px -10px; }
  }

  @keyframes pizote-step {
    from { rotate: -11deg; }
    to { rotate: 11deg; }
  }

  @keyframes pizote-tail {
    from { rotate: -4deg; }
    to { rotate: 5deg; }
  }

  @keyframes pizote-sniff {
    from { rotate: -2deg; }
    to { rotate: 3deg; }
  }
</style>
