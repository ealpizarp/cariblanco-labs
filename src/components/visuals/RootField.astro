---
/**
 * Root network for the hero. Three service nodes sit at the tips, tagged
 * like hosts on a network map. Once the roots have grown, small pulses of
 * data travel along them, out from the centre and back. Decorative: the
 * headline and lede carry the meaning. Reduced motion shows it still.
 */
interface Props {
  site: string;
  auto: string;
  care: string;
}

const { site, auto, care } = Astro.props;

/** The three roots, from the seed out to each node. */
const roots = {
  site: 'M188 236 C 160 190 132 140 108 100',
  auto: 'M188 236 C 250 200 340 160 430 138',
  care: 'M188 236 C 250 290 320 330 384 346',
};

/** Data on the roots: out to each node, and messages coming back in. */
const pulses = [
  { d: roots.site, delay: 2.0, time: 2.6, inbound: false },
  { d: roots.auto, delay: 2.5, time: 3.2, inbound: false },
  { d: roots.care, delay: 3.1, time: 2.9, inbound: false },
  { d: roots.auto, delay: 3.9, time: 3.2, inbound: true },
  { d: roots.site, delay: 4.6, time: 2.6, inbound: true },
];
---

<div class="root-field">
  <svg class="root-field__emboss" viewBox="0 0 520 440" fill="none" aria-hidden="true">
    <path d="M36 320 C 120 280 150 200 128 96" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
    <path d="M48 210 C 140 250 200 340 360 400" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
    <path d="M70 360 C 160 330 220 280 300 250" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
    <path d="M150 200 C 126 168 108 176 84 158" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
  </svg>

  <svg class="root-field__draw" viewBox="0 0 520 440" fill="none" aria-hidden="true">
    <path class="root-field__path root-field__path--site" pathLength="100" d="M188 236 C 160 190 132 140 108 100" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
    <path class="root-field__path root-field__path--auto" pathLength="100" d="M188 236 C 250 200 340 160 430 138" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
    <path class="root-field__path root-field__path--care" pathLength="100" d="M188 236 C 250 290 320 330 384 346" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
    <path class="root-field__hair" pathLength="100" d="M148 168 C 118 150 96 158 72 142" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
    <path class="root-field__hair" pathLength="100" d="M246 188 C 228 156 214 132 196 112" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
    <path class="root-field__hair" pathLength="100" d="M260 300 C 248 340 210 368 176 386" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
    <path class="root-field__hair" pathLength="100" d="M210 250 C 176 268 150 256 124 278" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
    <circle cx="188" cy="236" r="11" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4" />
    <circle class="root-field__seed" cx="188" cy="236" r="4.5" fill="currentColor" />
    <circle cx="108" cy="100" r="3.25" fill="currentColor" />
    <circle cx="430" cy="138" r="3.25" fill="currentColor" />
    <circle cx="384" cy="346" r="3.25" fill="currentColor" />
    {pulses.map((pulse) => (
      <circle
        class:list={['root-field__pulse', { 'root-field__pulse--in': pulse.inbound }]}
        r={pulse.inbound ? 2.4 : 3}
        style={`offset-path:path('${pulse.d}');--pulse-delay:${pulse.delay}s;--pulse-time:${pulse.time}s`}
      />
    ))}
  </svg>

  <p class="root-field__label root-field__label--site"><span class="root-field__dot"></span>{site}</p>
  <p class="root-field__label root-field__label--auto"><span class="root-field__dot"></span>{auto}</p>
  <p class="root-field__label root-field__label--care"><span class="root-field__dot"></span>{care}</p>
</div>

<style>
  .root-field {
    position: relative;
    width: 100%;
    aspect-ratio: 520 / 440;
  }

  .root-field__emboss,
  .root-field__draw {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .root-field__emboss {
    color: var(--root-emboss, var(--color-line-soft));
    opacity: 0.85;
  }

  /* Node tags, as on a network map: mono, outlined, with a live dot. */
  .root-field__label {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0.35rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--root-label, var(--color-primary-strong)) 40%, transparent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-dark-bg) 70%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-mono);
    line-height: 1;
    color: var(--root-label, var(--color-primary-strong));
    white-space: nowrap;
  }

  .root-field__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 25%, transparent);
  }

  /* Data pulses ride the roots via offset-path; hidden until they move. */
  .root-field__pulse {
    fill: var(--root-label, var(--color-primary-strong));
    opacity: 0;
    offset-rotate: 0deg;
  }

  .root-field__pulse--in {
    fill: var(--color-dark-emphasis, var(--color-clay));
  }

  .root-field__label--site {
    left: 21%;
    top: 14%;
    translate: -50% -140%;
  }

  .root-field__label--auto {
    left: 83%;
    top: 31%;
    translate: -100% -150%;
  }

  .root-field__label--care {
    left: 74%;
    top: 79%;
    translate: -40% 0.35rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .root-field__path,
    .root-field__hair {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: root-grow 1.45s var(--ease-out) forwards;
    }

    .root-field__path--auto { animation-delay: 0.16s; }
    .root-field__path--care { animation-delay: 0.28s; }
    .root-field__hair { animation-delay: 0.42s; animation-duration: 1.1s; }

    .root-field__label {
      animation: root-label 0.7s var(--ease-out) 0.7s both;
    }

    .root-field__pulse {
      animation: root-pulse var(--pulse-time, 3s) ease-in-out var(--pulse-delay, 2s) infinite;
    }

    .root-field__pulse--in {
      animation-name: root-pulse-in;
    }

    .root-field__dot {
      animation: root-dot 2.4s ease-in-out 1.4s infinite;
    }

    .root-field__path,
    .root-field__hair {
      transition: opacity var(--duration-base) var(--ease-out);
    }
  }

  @keyframes root-grow {
    to { stroke-dashoffset: 0; }
  }

  @keyframes root-label {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Travel the root, then rest a beat before the next packet. */
  @keyframes root-pulse {
    0% { offset-distance: 0%; opacity: 0; }
    8% { opacity: 1; }
    62% { opacity: 1; }
    70% { offset-distance: 100%; opacity: 0; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  @keyframes root-pulse-in {
    0% { offset-distance: 100%; opacity: 0; }
    8% { opacity: 1; }
    62% { opacity: 1; }
    70% { offset-distance: 0%; opacity: 0; }
    100% { offset-distance: 0%; opacity: 0; }
  }

  @keyframes root-dot {
    50% { box-shadow: 0 0 0 6px color-mix(in srgb, currentColor 0%, transparent); }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .root-field:has(.root-field__label--site:hover) .root-field__path:not(.root-field__path--site),
    .root-field:has(.root-field__label--auto:hover) .root-field__path:not(.root-field__path--auto),
    .root-field:has(.root-field__label--care:hover) .root-field__path:not(.root-field__path--care) {
      opacity: 0.28;
    }
  }
</style>
