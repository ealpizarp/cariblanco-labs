---
/**
 * The drawing for each lead service, shared by the home index and the
 * services page. Each shows the service itself, with a cariblanco in it:
 *  - site:      a website in a browser and a Google map pin with stars;
 *               a cariblanco sits on top of the pin.
 *  - shop:      a cariblanco peeking out of a shopping bag, between a booking
 *               calendar and a payment card.
 *  - assistant: a customer's question and the assistant's reply, after
 *               hours (the moon); the cariblanco is the one answering.
 *
 * Line work is drawn twice: a soft offset "emboss", then the ink, which
 * draws itself in three beats (first, later, last) when the sketch scrolls
 * into view. Colours come from custom properties so the same drawing sits
 * on mist or on moss. Reduced motion shows it finished. Decorative.
 */
import type { SketchId } from '@/data/services';
import Cariblanco from './Cariblanco.astro';

interface Props {
  stage: SketchId;
  class?: string;
}

const { stage, class: className } = Astro.props;

/** One stroke: path data, an optional fill, and when it draws in. */
interface Line {
  d: string;
  fill?: 'leaf' | 'paper';
  beat?: 'later' | 'last';
}

/** Five-point star centred on (x, y), for the review rating. */
function star(x: number, y: number, r: number): string {
  const points = Array.from({ length: 10 }, (_, i) => {
    const angle = -Math.PI / 2 + (i * Math.PI) / 5;
    const radius = i % 2 === 0 ? r : r * 0.45;
    return `${(x + radius * Math.cos(angle)).toFixed(1)} ${(y + radius * Math.sin(angle)).toFixed(1)}`;
  });
  return `M${points.join(' L')} Z`;
}

/** A rounded pill from (x, y), w by h. */
const pill = (x: number, y: number, w: number, h: number): string => {
  const r = h / 2;
  return `M${x + r} ${y} H${x + w - r} A${r} ${r} 0 0 1 ${x + w - r} ${y + h} H${x + r} A${r} ${r} 0 0 1 ${x + r} ${y} Z`;
};

const drawings: Record<SketchId, { ground: [number, number, number, number]; lines: Line[] }> = {
  site: {
    ground: [160, 212, 128, 12],
    lines: [
      // Browser window, toolbar and address bar.
      { d: 'M70 30 H222 C229 30 234 35 234 42 V150 C234 157 229 162 222 162 H70 C63 162 58 157 58 150 V42 C58 35 63 30 70 30 Z', fill: 'paper' },
      { d: 'M58 50 H234' },
      { d: pill(95, 36, 106, 8), beat: 'later' },
      // Hero picture: hills and a sun.
      { d: 'M76 60 H160 C163 60 165 62 165 65 V106 C165 109 163 111 160 111 H76 C73 111 71 109 71 106 V65 C71 62 73 60 76 60 Z', fill: 'leaf', beat: 'later' },
      { d: 'M74 108 L98 84 L112 96 L126 80 L162 108', beat: 'last' },
      // Headline, text and the button.
      { d: 'M178 64 H220', beat: 'later' },
      { d: 'M178 75 H212', beat: 'later' },
      { d: 'M178 86 H216', beat: 'later' },
      { d: pill(178, 98, 43, 14), fill: 'leaf', beat: 'last' },
      { d: 'M71 126 H158', beat: 'later' },
      { d: 'M71 137 H136', beat: 'later' },
      { d: 'M71 148 H120', beat: 'later' },
      // Google Business: the map pin.
      { d: 'M246 196 C232 178 222 166 222 152 C222 139 233 128 246 128 C259 128 270 139 270 152 C270 166 260 178 246 196 Z', fill: 'leaf' },
      { d: 'M239 145 A7 7 0 1 0 253 145 A7 7 0 1 0 239 145 Z', fill: 'paper', beat: 'later' },
    ],
  },
  shop: {
    ground: [160, 200, 130, 12],
    lines: [
      // Booking calendar.
      { d: 'M34 92 H96 C100 92 103 95 103 99 V160 C103 164 100 167 96 167 H34 C30 167 27 164 27 160 V99 C27 95 30 92 34 92 Z', fill: 'paper' },
      { d: 'M27 108 H103', beat: 'later' },
      { d: 'M44 86 V98', beat: 'later' },
      { d: 'M86 86 V98', beat: 'later' },
      // Payment card: stripe, number, contactless.
      { d: 'M214 118 L282 128 C286 128.6 288.6 132.4 288 136.4 L282 176 C281.4 180 277.6 182.6 273.6 182 L206 172 C202 171.4 199.4 167.6 200 163.6 L206 124 C206.6 120 210.4 117.4 214 118 Z', fill: 'leaf' },
      { d: 'M204 140 L287 152', beat: 'later' },
      { d: 'M214 162 L236 165.3', beat: 'last' },
      { d: 'M262 136 A8 8 0 0 1 265 145 M268 134 A14 14 0 0 1 272 149', beat: 'last' },
      // The bag, its handles and a price tag.
      { d: 'M138 96 C136 66 184 66 182 96', beat: 'later' },
      { d: 'M118 96 H202 L210 198 H110 Z', fill: 'paper' },
      { d: 'M150 128 H170 L176 136 L170 144 H150 Z', fill: 'leaf', beat: 'last' },
    ],
  },
  assistant: {
    ground: [160, 214, 130, 11],
    lines: [
      // The customer asks.
      { d: 'M58 34 H156 C163 34 168 39 168 46 V64 C168 71 163 76 156 76 H72 L54 88 L58 76 C51 75 46 70 46 64 V46 C46 39 51 34 58 34 Z', fill: 'paper' },
      { d: 'M62 50 H150', beat: 'later' },
      { d: 'M62 61 H124', beat: 'later' },
      // The assistant answers.
      { d: 'M120 96 H226 C233 96 238 101 238 108 V136 C238 143 233 148 226 148 L238 160 L208 148 H120 C113 148 108 143 108 136 V108 C108 101 113 96 120 96 Z', fill: 'leaf' },
      { d: 'M122 112 H222', beat: 'later' },
      { d: 'M122 123 H214', beat: 'later' },
      { d: 'M122 134 H184', beat: 'later' },
      // And the conversation goes on.
      { d: pill(38, 168, 64, 20), beat: 'last' },
      // After hours.
      { d: 'M280 26 C270 28 264 38 266 48 C268 58 278 64 288 62 C282 58 278 50 279 42 C280 34 284 28 290 26 C287 25 283 25 280 26 Z', fill: 'leaf', beat: 'last' },
    ],
  },
};

const art = drawings[stage];
const [gx, gy, grx, gry] = art.ground;
---

<div class:list={['sketch', 'reveal', className]}>
  <svg class="plan__draw" viewBox="0 0 320 240" fill="none">
    <ellipse class="plan__ground" cx={gx} cy={gy} rx={grx} ry={gry} />

    <g class="plan__emboss" stroke-linecap="round" stroke-linejoin="round">
      {art.lines.map((line) => <path d={line.d} />)}
    </g>

    {/* In the bag: drawn before the ink, so the bag's front covers it. */}
    {stage === 'shop' && (
      <g class="plan__monkey">
        <Cariblanco pose="peek" x={125} y={46} width={70} height={52.5} />
      </g>
    )}

    <g class="plan__ink" stroke-linecap="round" stroke-linejoin="round">
      {art.lines.map((line) => (
        <path
          class:list={[
            'plan__path',
            line.beat && `plan__path--${line.beat}`,
            line.fill === 'leaf' && 'plan__leaf',
            line.fill === 'paper' && 'plan__paper',
          ]}
          pathLength="100"
          d={line.d}
        />
      ))}
    </g>

    {stage === 'site' && (
      <>
        <g class="plan__dots">
          <circle cx="68" cy="40" r="2.2" /><circle cx="76" cy="40" r="2.2" /><circle cx="84" cy="40" r="2.2" />
        </g>
        <circle class="plan__bud plan__bud--clay" cx="148" cy="72" r="4.5" />
        <g class="plan__bud plan__bud--clay">
          {[0, 1, 2, 3, 4].map((i) => <path d={star(210 + i * 12, 212, 4.6)} />)}
        </g>
        {/* Sits on the pin's top (seat 116 of its 150-tall box). */}
        <g class="plan__monkey">
          <Cariblanco pose="sit" x={229} y={79} width={34} height={63.75} />
        </g>
      </>
    )}

    {stage === 'shop' && (
      <>
        <g class="plan__dots">
          {[0, 1, 2, 3].map((c) => [0, 1, 2].map((r) => <circle cx={40 + c * 16} cy={122 + r * 15} r="1.8" />))}
        </g>
        <g class="plan__bud">
          <circle class="plan__booked" cx="88" cy="137" r="7" />
          <circle class="plan__bud--clay" cx="88" cy="137" r="2.2" />
          <circle class="plan__bud--clay" cx="155" cy="136" r="2.4" />
        </g>
      </>
    )}

    {stage === 'assistant' && (
      <>
        <g class="plan__dots plan__typing">
          <circle cx="58" cy="178" r="2.4" /><circle cx="70" cy="178" r="2.4" /><circle cx="82" cy="178" r="2.4" />
        </g>
        <g class="plan__bud">
          <path class="plan__bud--clay" d="M100 92 L103 101 L112 104 L103 107 L100 116 L97 107 L88 104 L97 101 Z" />
          <circle class="plan__star" cx="250" cy="44" r="1.6" />
          <circle class="plan__star" cx="300" cy="66" r="1.4" />
        </g>
        <g class="plan__monkey">
          <Cariblanco pose="sit" hold="leaf" x={246} y={147} width={44} height={82.5} />
        </g>
      </>
    )}
  </svg>
</div>

<style>
  .sketch {
    --sketch-ink: var(--color-moss-800);
    --sketch-emboss: var(--color-line-soft);
    --sketch-leaf: var(--color-wash-leaf);
    --sketch-ground: var(--color-wash);
    --sketch-bud: var(--color-clay);
    /* Opaque fill for shapes that sit in front of others; the ground the
       drawing is on. Also the outline where a monkey's arm crosses it. */
    --sketch-paper: var(--color-surface);
    --sketch-mark: var(--color-paper);
  }

  .sketch :global(.plan__draw) {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
    color: var(--sketch-ink);
  }

  .sketch :global(.plan__ground) {
    fill: var(--sketch-ground);
  }

  .sketch :global(.plan__emboss),
  .sketch :global(.plan__ink) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }

  .sketch :global(.plan__emboss) {
    color: var(--sketch-emboss);
    opacity: 0.9;
    transform: translate(1.6px, 2px);
  }

  .sketch :global(.plan__ink) {
    stroke-width: 1.3;
  }

  .sketch :global(.plan__leaf) {
    fill: var(--sketch-leaf);
  }

  .sketch :global(.plan__paper) {
    fill: var(--sketch-paper);
  }

  .sketch :global(.plan__dots),
  .sketch :global(.plan__star) {
    fill: currentColor;
  }

  .sketch :global(.plan__bud--clay) {
    fill: var(--sketch-bud);
  }

  .sketch :global(.plan__booked) {
    fill: none;
    stroke: var(--sketch-bud);
    stroke-width: 1.3;
  }

  .sketch :global(.plan__monkey) {
    color: var(--sketch-ink);
    --cb-hood: var(--sketch-mark);
    --cb-ring: var(--sketch-paper);
    --cb-leaf: var(--sketch-leaf);
    --cb-vine: var(--sketch-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sketch :global(.plan__path) {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: sketch-grow 0.85s var(--ease-out) 0.15s forwards;
    }

    .sketch :global(.plan__path--later) {
      animation-duration: 0.7s;
      animation-delay: 0.37s;
    }

    .sketch :global(.plan__path--last) {
      animation-duration: 0.6s;
      animation-delay: 0.57s;
    }

    /* Paper fills are there from the start, so what is behind stays hidden;
       leaf fills wash in once the lines are drawn. */
    .sketch :global(.plan__leaf) {
      fill: transparent;
      animation-name: sketch-grow, sketch-leaf;
      animation-duration: 0.85s, 0.4s;
      animation-delay: 0.15s, 0.85s;
      animation-timing-function: var(--ease-out);
      animation-fill-mode: forwards;
    }

    .sketch :global(.plan__path--later.plan__leaf) {
      animation-duration: 0.7s, 0.4s;
      animation-delay: 0.37s, 0.9s;
    }

    .sketch :global(.plan__path--last.plan__leaf) {
      animation-duration: 0.6s, 0.4s;
      animation-delay: 0.57s, 1s;
    }

    .sketch :global(.plan__dots),
    .sketch :global(.plan__bud) {
      opacity: 0;
      animation: sketch-bud 0.35s var(--ease-out) 1.05s forwards;
    }

    /* The cariblanco arrives last, with a small hop. */
    .sketch :global(.plan__monkey) {
      opacity: 0;
      animation: sketch-monkey 0.5s cubic-bezier(0.3, 1.4, 0.5, 1) 1.2s forwards;
    }

    /* Someone is typing. */
    .sketch :global(.plan__typing circle) {
      animation: sketch-typing 1.2s ease-in-out 1.6s infinite;
    }

    .sketch :global(.plan__typing circle:nth-child(2)) {
      animation-delay: 1.8s;
    }

    .sketch :global(.plan__typing circle:nth-child(3)) {
      animation-delay: 2s;
    }

    /* Below the fold the motion script holds the drawing until it is seen. */
    .sketch.reveal--wait:not(.is-in) :global(*) {
      animation-play-state: paused;
    }
  }

  @keyframes sketch-grow {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes sketch-leaf {
    to {
      fill: var(--sketch-leaf);
    }
  }

  @keyframes sketch-bud {
    to {
      opacity: 1;
    }
  }

  @keyframes sketch-monkey {
    from {
      opacity: 0;
      translate: 0 8px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes sketch-typing {
    0%, 60%, 100% {
      translate: 0 0;
    }
    30% {
      translate: 0 -3px;
    }
  }
</style>
