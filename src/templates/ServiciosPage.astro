---
/**
 * The services page: the three lead services in full, the further services as cards, monthly care (the base), the
 * questions people ask, and a close for anyone unsure: start with a
 * check-up, with a cariblanco thinking it over under a hanging vine.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Cariblanco from '@/components/visuals/Cariblanco.astro';
import Vine from '@/components/visuals/Vine.astro';
import ServiceDetails from '@/components/sections/ServiceDetails.astro';
import ServiceFaq from '@/components/sections/ServiceFaq.astro';
import ServiceMore from '@/components/sections/ServiceMore.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import { getServices } from '@/data/services';
import { breadcrumbJsonLd, servicesJsonLd } from '@/data/structured-data';
import { routes, useI18n } from '@/i18n';

if (!Astro.site) {
  throw new Error('`site` must be set in astro.config.ts to build canonical URLs.');
}

const { locale, t, path } = useI18n(Astro);
const meta = t.pages.servicios;
const services = getServices(locale);
const start = services.find((service) => service.id === 'diagnostico');
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  extraJsonLd={[
    breadcrumbJsonLd(Astro.site, [{ name: meta.eyebrow, path: path(routes.servicios) }], locale),
    servicesJsonLd(Astro.site, locale),
  ]}
>
  <PageHeader eyebrow={meta.eyebrow} title={meta.heading} lede={meta.lede} />

  <ServiceDetails tier="lead" />
  <ServiceMore />
  <ServiceDetails tier="base" />
  <ServiceFaq />

  {start && (
    <section id={start.id} class="section section--page plan-close" aria-labelledby="plan-unsure">
      <Vine kind="hang" length={190} leaves={6} sway class="plan-close__vine" />
      <div class="container plan-close__layout">
        <div class="plan-close__inner">
          <p class="eyebrow">{t.services.startLabel}</p>
          <h2 id="plan-unsure">
            {t.services.unsure}
            {' '}
            <em>{t.services.startText}</em>
          </h2>
          <p class="plan-close__summary">{start.summary}</p>
          <ul class="plan-close__includes">
            {start.includes.map((item) => <li>{item}</li>)}
          </ul>
          <Button href={path(routes.contacto)}>{t.services.startCta}</Button>
        </div>
        <div class="plan-close__scene" aria-hidden="true">
          <Cariblanco pose="sit" think class="plan-close__cariblanco" />
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Sections reached by a link (#mas, #preguntas…) stop below the
     sticky header. */
  :global(main section[id]) {
    scroll-margin-top: var(--header-height);
  }

  /* ---- The close: start with a check-up ---- */
  .plan-close {
    position: relative;
    padding-top: var(--space-section-gap);
    border-top: 1px solid var(--color-rule-strong);
  }

  .plan-close__layout {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .plan-close__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    max-width: 40rem;
  }

  .plan-close__inner h2 {
    max-width: 22ch;
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
  }

  .plan-close__inner h2 em {
    display: block;
    font-style: italic;
    color: var(--color-clay);
  }

  .plan-close__summary {
    max-width: 52ch;
    color: var(--color-text-soft);
  }

  .plan-close__includes {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .plan-close__includes li {
    position: relative;
    padding-left: 1.6rem;
  }

  /* A small tick in clay, like the deed on the process page. */
  .plan-close__includes li::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.35em;
    width: 0.45rem;
    height: 0.8rem;
    border-right: 2px solid var(--color-clay);
    border-bottom: 2px solid var(--color-clay);
    rotate: 40deg;
  }

  /* Not sure where to start: a cariblanco scratching its head, and a
     liana hanging from the top of the section beside it. */
  .plan-close__scene {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--color-rule-strong);
    color: var(--color-primary);
  }

  .plan-close :global(.plan-close__vine) {
    position: absolute;
    top: 0;
    right: calc(max(var(--gutter), (100% - var(--container-max)) / 2) + clamp(4.4rem, 7vw, 5.6rem) + 1rem);
    width: 2.6rem;
    color: var(--color-moss-700);
    --vine-leaf: var(--color-lichen-100);
  }

  /* The seat is 116 of 150 down the box; the tail hangs below it, so the
     box drops past the ground line. */
  .plan-close__scene :global(.plan-close__cariblanco) {
    width: clamp(4.4rem, 7vw, 5.6rem);
    margin-bottom: calc(clamp(4.4rem, 7vw, 5.6rem) * -0.42);
  }

  @media (max-width: 599px) {
    .plan-close :global(.plan-close__vine) {
      display: none;
    }
  }
</style>
