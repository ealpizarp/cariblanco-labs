---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import PawTrail from '@/components/visuals/PawTrail.astro';
import Pizote from '@/components/visuals/Pizote.astro';
import ServiceDetails from '@/components/sections/ServiceDetails.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import { breadcrumbJsonLd, servicesJsonLd } from '@/data/structured-data';
import { routes, useI18n } from '@/i18n';

if (!Astro.site) {
  throw new Error('`site` must be set in astro.config.ts to build canonical URLs.');
}

const { locale, t, path } = useI18n(Astro);
const meta = t.pages.servicios;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  extraJsonLd={[
    breadcrumbJsonLd(Astro.site, [{ name: meta.eyebrow, path: path(routes.servicios) }], locale),
    servicesJsonLd(Astro.site, locale),
  ]}
>
  <PageHeader eyebrow={meta.eyebrow} title={meta.heading} lede={meta.lede} />
  <ServiceDetails />
  <section class="section section--page plan-close" aria-labelledby="plan-unsure">
    <div class="container plan-close__layout">
      <div class="plan-close__inner">
        <h2 id="plan-unsure">{t.services.unsure}</h2>
        <Button href={path(routes.contacto)}>{t.nav.letsTalk}</Button>
      </div>
      <div class="plan-close__scene" aria-hidden="true">
        <PawTrail count={5} direction="right" class="plan-close__tracks" />
        <Pizote pose="sniff" class="plan-close__pizote" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Follows the lichen "base" band, so it needs its own top spacing
     (`.section--page` assumes it continues a section of the same colour). */
  .plan-close {
    padding-top: var(--space-section-gap);
  }

  .plan-close__layout {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  /* Not sure where to start: a pizote sniffing out the way, tracks behind. */
  .plan-close__scene {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--color-rule-strong);
    color: var(--color-primary);
  }

  .plan-close__scene :global(.plan-close__tracks) {
    height: 1.4rem;
    margin-bottom: 0.2rem;
    opacity: 0.6;
  }

  .plan-close__scene :global(.plan-close__pizote) {
    width: clamp(7rem, 14vw, 11rem);
    --pz-ring: var(--color-bg);
    --pz-mark: var(--color-paper);
  }

  @media (max-width: 600px) {
    .plan-close__scene :global(.plan-close__tracks) {
      display: none;
    }
  }

  .plan-close__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    max-width: 36rem;
  }

  .plan-close__inner h2 {
    max-width: 18ch;
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
  }
</style>
