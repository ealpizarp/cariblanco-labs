// Cloudflare Workers: static assets plus a small worker for cookie-aware
// locale redirects (`src/edge/worker.ts`). No secrets belong here.
//
// Deploy (after `npm run build`):   npx wrangler deploy
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // Must match the Worker that Cloudflare Workers Builds deploys.
  "name": "foresta-works",
  "compatibility_date": "2026-09-01",
  "main": "src/edge/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // The worker only decides redirects for page URLs. Hashed build output,
    // decor, icons and metadata files are served straight from the edge.
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/decor/*",
      "!/favicon.svg",
      "!/*.webmanifest",
      "!/robots.txt",
      "!/sitemap-*"
    ]
  },
  "previews": {}
}
